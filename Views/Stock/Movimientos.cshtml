@using mi_ferreteria.Models
@{
    ViewData["Title"] = "Movimientos de Stock";
    var movimientos = ViewBag.Movimientos as IEnumerable<StockMovimiento> ?? Enumerable.Empty<StockMovimiento>();
    var prodNames = ViewBag.ProductNames as System.Collections.Generic.IDictionary<long, string> ?? new System.Collections.Generic.Dictionary<long, string>();
    var prodUnits = ViewBag.ProductUnits as System.Collections.Generic.IDictionary<long, string> ?? new System.Collections.Generic.Dictionary<long, string>();
    int page = ViewBag.Page is int p ? p : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var pgStart = System.Math.Max(1, page - 2);
    var pgEnd = System.Math.Min(totalPages, page + 2);
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Movimientos de Stock
        </h2>
        <p class="mt-1 text-sm text-gray-500">Ingresos y egresos registrados en el inventario.</p>
    </div>
    <div class="mt-4 flex sm:ml-4 sm:mt-0">
        <a asp-action="Index"
           class="btn-action-secondary inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-semibold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver a Stock
        </a>
    </div>
</div>

@if (!movimientos.Any())
{
    <div class="text-center rounded-md bg-gray-50 p-12 border border-dashed border-gray-300">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900">Sin movimientos</h3>
        <p class="mt-1 text-sm text-gray-500">Aún no se han registrado movimientos de stock.</p>
    </div>
}
else
{
    <div class="flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Fecha</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Producto</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Tipo</th>
                                <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Cantidad</th>
                                <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Precio compra</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Motivo</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var m in movimientos)
                            {
                                var esIngreso = string.Equals(m.Tipo, "INGRESO", System.StringComparison.OrdinalIgnoreCase);
                                var signo = esIngreso ? "+" : "-";
                                var precio = m.PrecioCompra.HasValue ? m.PrecioCompra.Value.ToString("C") : "-";
                                var nombreProducto = prodNames.ContainsKey(m.ProductoId) ? prodNames[m.ProductoId] : ("#" + m.ProductoId);
                                var unidad = prodUnits.ContainsKey(m.ProductoId) ? prodUnits[m.ProductoId] : "";
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6">
                                        @m.Fecha.LocalDateTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <a asp-controller="Producto" asp-action="Details" asp-route-id="@m.ProductoId"
                                           class="font-medium text-gray-900 hover:underline" style="color:#FC651F;">
                                            @nombreProducto
                                        </a>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @(esIngreso ? "bg-green-50 text-green-700 ring-green-600/20" : "bg-red-50 text-red-700 ring-red-600/10")">
                                            @(esIngreso ? "Ingreso" : "Egreso")
                                        </span>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm font-semibold text-right @(esIngreso ? "text-green-700" : "text-red-600")">
                                        @signo@m.Cantidad @unidad
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 text-right">@precio</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-400">
                                        @(!string.IsNullOrWhiteSpace(m.Motivo) ? m.Motivo : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 mt-2 rounded-b-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                <a asp-action="Movimientos" asp-route-page="@(page - 1)"
                   class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                <a asp-action="Movimientos" asp-route-page="@(page + 1)"
                   class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <p class="text-sm text-gray-700">Página <span class="font-medium">@(page)</span> de <span class="font-medium">@(totalPages)</span></p>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    <a asp-action="Movimientos" asp-route-page="@(page - 1)"
                       class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Anterior</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                    </a>
                    @for (var i = pgStart; i <= pgEnd; i++)
                    {
                        if (i == page)
                        {
                            <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                        }
                        else
                        {
                            <a asp-action="Movimientos" asp-route-page="@i"
                               class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20">@i</a>
                        }
                    }
                    <a asp-action="Movimientos" asp-route-page="@(page + 1)"
                       class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page >= totalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Siguiente</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                    </a>
                </nav>
            </div>
        </div>
    }
}
