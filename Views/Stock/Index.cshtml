@model mi_ferreteria.ViewModels.StockCargaViewModel
@using mi_ferreteria.Models
@using mi_ferreteria.ViewModels
@using System.Text.Json
@using System.Linq
@{
    var productos = ViewBag.Productos as IEnumerable<Producto> ?? Enumerable.Empty<Producto>();
    var stocks = ViewBag.Stocks as System.Collections.Generic.IDictionary<long, long> ?? new System.Collections.Generic.Dictionary<long, long>();
    var q = ViewBag.Query as string ?? string.Empty;
    int page = ViewBag.Page is int pageValue ? pageValue : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var lineasIniciales = Model?.Lineas ?? new List<mi_ferreteria.ViewModels.StockCargaLineaViewModel>();
    var lineasJson = JsonSerializer.Serialize(lineasIniciales);
    var tipoMovimiento = (Model?.TipoMovimiento ?? "INGRESO").ToUpperInvariant();
    var esIngreso = tipoMovimiento == "INGRESO";
    var preciosCompra = ViewBag.PreciosCompra as System.Collections.Generic.IDictionary<long, decimal?> ?? new System.Collections.Generic.Dictionary<long, decimal?>();
    var stockCriticos = ViewBag.StockCriticos as System.Collections.Generic.HashSet<long> ?? new System.Collections.Generic.HashSet<long>();
    var detalleCriticos = ViewBag.StockCriticosDetalle as System.Collections.Generic.List<StockCriticoViewModel> ?? new System.Collections.Generic.List<StockCriticoViewModel>();
    var totalCriticos = ViewBag.StockCriticosCount is int sc ? sc : detalleCriticos.Count;
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Gestión de Stock
        </h2>
        <p class="mt-1 text-sm text-gray-500">
            Seleccioná productos desde el listado, definí las cantidades y registrá ingresos o egresos.
            El precio de compra solo aplica para los ingresos.
        </p>
    </div>
    <div class="mt-4 flex sm:ml-4 sm:mt-0 gap-2">
        <a asp-action="Movimientos"
           class="btn-action-secondary inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-semibold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Últimos movimientos
        </a>
        <a asp-action="Criticos"
           class="btn-action-secondary inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-semibold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Stock crítico
        </a>
    </div>
</div>

@if (TempData["StockOk"] != null)
{
    <div class="rounded-lg bg-green-50 border border-green-200 p-4 mb-4 text-sm text-green-800">@TempData["StockOk"]</div>
}
@if (TempData["StockError"] != null)
{
    <div class="rounded-lg bg-red-50 border border-red-200 p-4 mb-4 text-sm text-red-700">@TempData["StockError"]</div>
}
@if (totalCriticos > 0)
{
    var resumenCriticos = string.Join(", ", detalleCriticos.Take(5).Select(d => d.Nombre));
    if (detalleCriticos.Count > 5) resumenCriticos += $" y {detalleCriticos.Count - 5} más";
    <a asp-action="Criticos" class="flex items-start gap-3 rounded-lg bg-amber-50 border border-amber-200 p-4 mb-4 hover:bg-amber-100 transition-colors no-underline">
        <svg class="h-5 w-5 text-amber-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <div>
            <p class="text-sm font-semibold text-amber-800">Prioridad: @totalCriticos producto@(totalCriticos == 1 ? "" : "s") en stock crítico</p>
            <p class="text-xs text-amber-700 mt-0.5">@resumenCriticos</p>
        </div>
    </a>
}

<div class="rounded-xl border border-gray-200 bg-white shadow-sm mb-4 p-5">
        <h4 class="mb-3 text-gray-900 font-semibold">Productos</h4>
        <form method="get" asp-action="Index" class="mb-4">
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <input type="search"
                           id="buscadorProductos"
                           name="q"
                           value="@q"
                           class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-4 pr-10 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]"
                           placeholder="Buscar por cualquier dato (SKU, nombre, descripción, ubicación, etc.)"
                           aria-label="Buscar productos" />
                </div>
                <input type="hidden" name="page" value="1" />
                <button type="submit"
                        class="group flex items-center justify-center rounded-lg bg-gray-900 p-2.5 text-white shadow-sm transition-colors duration-200 hover:bg-[#FC651F] focus:outline-none focus:ring-2 focus:ring-[#FC651F] focus:ring-offset-1"
                        title="Buscar">
                    <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
                    </svg>
                </button>
                @if (!string.IsNullOrWhiteSpace(q))
                {
                    <a asp-action="Index" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900">
                        Limpiar
                    </a>
                }
            </div>
        </form>

        @if (!productos.Any())
        {
            <div class="alert alert-info">No hay productos para mostrar.</div>
        }
        else
        {
            var pgStart = System.Math.Max(1, page - 2);
            var pgEnd = System.Math.Min(totalPages, page + 2);
            <div class="mt-2 flow-root">
                <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                            <table class="min-w-full divide-y divide-gray-300 table-products">
                                <thead>
                                    <tr>
                                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-white sm:pl-6">ID</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">SKU</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Nombre</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Unidad</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Stock</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Precio venta</th>
                                        <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Ult. compra</th>
                                        <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-white">Acción</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200 bg-white" id="productosBody">
                                @foreach (var p in productos)
                                {
                                    var stock = stocks != null && stocks.TryGetValue(p.Id, out var s) ? s : 0;
                                    var esCritico = stockCriticos.Contains(p.Id);
                                    var rowClasses = "transition-colors " + (esCritico ? "bg-amber-50/50 hover:bg-amber-100" : "hover:bg-gray-50");
                                    <tr class="@rowClasses">
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">@p.Id</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 font-mono text-xs">@p.Sku</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">@p.Nombre</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@p.UnidadMedida</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">
                                            @stock
                                            @if (esCritico)
                                            {
                                                <span class="ml-2 inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Crítico</span>
                                            }
                                        </td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900">$ @p.PrecioVentaActual.ToString("0.00")</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@(preciosCompra.TryGetValue(p.Id, out var pc) && pc.HasValue ? pc.Value.ToString("0.00") : "-")</td>
                                        <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                            <button type="button"
                                                    class="btn-producto inline-flex items-center rounded-md px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors"
                                                    style="background-color:#FC651F;"
                                                    onmouseover="this.style.backgroundColor='#e0541a'" onmouseout="this.style.backgroundColor='#FC651F'"
                                                    data-id="@p.Id"
                                                    data-sku="@p.Sku"
                                                    data-nombre="@p.Nombre"
                                                    data-unidad="@p.UnidadMedida"
                                                    data-stock="@stock"
                                                    data-critico="@(esCritico ? "true" : "false")"
                                                    data-precioventa="@p.PrecioVentaActual"
                                                    data-preciocompra="@(preciosCompra.TryGetValue(p.Id, out var pc2) && pc2.HasValue ? pc2.Value.ToString() : string.Empty)"
                                                    onclick="agregarProductoDesdeBoton(this)">
                                                Modificar
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div id="paginacionProductos" class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 mt-2 rounded-b-lg">
                <div class="flex flex-1 justify-between sm:hidden">
                    <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                    <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page + 1)" class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
                </div>
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <p class="text-sm text-gray-700">Página <span class="font-medium">@(page)</span> de <span class="font-medium">@totalPages</span></p>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                            <span class="sr-only">Anterior</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                        </a>
                        @for (var i = pgStart; i <= pgEnd; i++)
                        {
                            if (i == page)
                            {
                                <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-q="@q" asp-route-page="@i" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20">@i</a>
                            }
                        }
                        <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page + 1)" class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page >= totalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                            <span class="sr-only">Siguiente</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </a>
                    </nav>
                </div>
            </div>
        }
</div>

<div class="rounded-xl border border-gray-200 bg-white shadow-sm mt-6">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900">Carga seleccionada</h3>
    </div>
    <div class="p-5">
        <form asp-action="Cargar" method="post" id="formCargas">
            @Html.AntiForgeryToken()

            <div class="flex flex-wrap items-end gap-4 mb-5">
                <div class="flex-1 min-w-[200px] max-w-xs">
                    <label asp-for="TipoMovimiento" class="block text-sm font-medium text-gray-700 mb-1">Tipo de movimiento</label>
                    <select asp-for="TipoMovimiento" id="tipoMovimientoSelect"
                            class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-3 pr-8 text-sm text-gray-900 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]">
                        <option value="INGRESO">Ingreso</option>
                        <option value="EGRESO">Egreso</option>
                    </select>
                    <span asp-validation-for="TipoMovimiento" class="text-xs text-red-600 mt-1"></span>
                </div>
                <p id="tipoMovimientoInfo" class="text-sm text-gray-500 pb-1">
                    @(esIngreso ? "Cada línea se registrará como un ingreso de stock." : "Cada línea se registrará como un egreso de stock.")
                </p>
            </div>

            <div class="overflow-x-auto rounded-lg border border-gray-200 mb-5">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 pl-4 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Producto</th>
                            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Unidad</th>
                            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-28">Cantidad</th>
                            <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Precio venta</th>
                            <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-36">Precio compra</th>
                            <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock actual</th>
                            <th class="px-3 py-3 pr-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider w-20"></th>
                        </tr>
                    </thead>
                    <tbody id="cargasBody" class="divide-y divide-gray-100 bg-white">
                        <tr><td colspan="7" class="py-8 text-center text-sm text-gray-400">No hay productos seleccionados.</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="Motivo" class="block text-sm font-medium text-gray-700 mb-1">Motivo (opcional)</label>
                    <input asp-for="Motivo"
                           class="block w-full rounded-lg border border-gray-300 bg-white py-2 px-3 text-sm text-gray-900 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]"
                           placeholder="Compra a proveedor, ajuste, inventario, etc." />
                    <span asp-validation-for="Motivo" class="text-xs text-red-600 mt-1"></span>
                </div>
                <div class="flex flex-col items-end gap-2">
                    <div class="text-xs text-red-600">@Html.ValidationSummary()</div>
                    <button type="submit" id="btnConfirmar" disabled
                            class="inline-flex items-center rounded-md px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                            style="background-color:#FC651F;" onmouseover="if(!this.disabled)this.style.backgroundColor='#e0541a'" onmouseout="this.style.backgroundColor='#FC651F'">
                        @(esIngreso ? "Registrar ingresos" : "Registrar egresos")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const lineasSeed = @Html.Raw(lineasJson);
        const lineas = Array.isArray(lineasSeed) ? [...lineasSeed] : [];
        const tipoMovimientoInicial = '@tipoMovimiento';
        const tbodyCargas = document.getElementById('cargasBody');
        const btnConfirmar = document.getElementById('btnConfirmar');
        const tipoMovimientoSelect = document.getElementById('tipoMovimientoSelect');
        const tipoMovimientoInfo = document.getElementById('tipoMovimientoInfo');

        function renderLineas() {
            if (!tbodyCargas) return;
            tbodyCargas.innerHTML = '';
            if (!lineas.length) {
                tbodyCargas.innerHTML = '<tr><td colspan="7" class="py-8 text-center text-sm text-gray-400">No hay productos seleccionados.</td></tr>';
                if (btnConfirmar) btnConfirmar.disabled = true;
                return;
            }

            lineas.forEach((l, idx) => {
                const tr = document.createElement('tr');
                const nombre = l.ProductoNombre || ('#' + l.ProductoId);
                const unidad = l.UnidadMedida || 'unidad';
                const cantidad = (l.Cantidad && l.Cantidad > 0) ? l.Cantidad : 1;
                const precioVenta = typeof l.PrecioVenta === 'number' ? l.PrecioVenta : 0;
                const ultimoCompra = typeof l.UltimoPrecioCompra === 'number' ? l.UltimoPrecioCompra : null;
                const precio = typeof l.PrecioCompra === 'number' ? l.PrecioCompra : (ultimoCompra !== null ? ultimoCompra : '');
                const stockActual = typeof l.StockActual === 'number' ? l.StockActual : 0;

                const inputCls = 'block w-full rounded-md border border-gray-300 bg-white py-1.5 px-2.5 text-sm text-gray-900 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]';
                tr.innerHTML = `
                    <td class="whitespace-nowrap py-3 pl-4 pr-3 text-sm text-gray-900">
                        <input type="hidden" name="Lineas[${idx}].ProductoId" value="${l.ProductoId}" />
                        <input type="hidden" name="Lineas[${idx}].ProductoNombre" value="${nombre.replace(/\"/g, '')}" />
                        <input type="hidden" name="Lineas[${idx}].UnidadMedida" value="${unidad}" />
                        <input type="hidden" name="Lineas[${idx}].StockActual" value="${stockActual}" />
                        ${nombre}
                    </td>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">${unidad}</td>
                    <td class="whitespace-nowrap px-3 py-3">
                        <input type="number" class="${inputCls}" min="1" step="1"
                               name="Lineas[${idx}].Cantidad"
                               value="${cantidad}"
                               data-idx="${idx}"
                               oninput="actualizarCantidad(this)" />
                    </td>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900 text-right">${precioVenta > 0 ? precioVenta.toFixed(2) : '-'}</td>
                    <td class="whitespace-nowrap px-3 py-3">
                        <input type="number" class="${inputCls}" min="0" step="0.01"
                               name="Lineas[${idx}].PrecioCompra"
                               value="${precio !== '' ? precio : ''}"
                               data-idx="${idx}"
                               oninput="actualizarPrecio(this)" />
                        ${ultimoCompra !== null ? `<p class="text-xs text-gray-400 mt-1">Ult: ${ultimoCompra.toFixed(2)}</p>` : ''}
                    </td>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900 text-right">${stockActual}</td>
                    <td class="whitespace-nowrap px-3 py-3 pr-4 text-right">
                        <button type="button"
                                class="inline-flex items-center rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-red-600 shadow-sm hover:bg-red-50 hover:border-red-300 transition-colors"
                                onclick="quitarLinea(${l.ProductoId})">Quitar</button>
                    </td>
                `;
                tbodyCargas.appendChild(tr);
            });
            if (btnConfirmar) btnConfirmar.disabled = false;
            aplicarTipoMovimientoEnUI();
        }

        function agregarProductoDesdeBoton(btn) {
            const id = parseInt(btn.getAttribute('data-id') || '0', 10);
            if (!id) return;
            const existente = lineas.find(x => x.ProductoId === id);
            if (existente) {
                existente.Cantidad = (existente.Cantidad || 0) + 1;
                renderLineas();
                return;
            }
            const nombre = btn.getAttribute('data-nombre') || '';
            const unidad = btn.getAttribute('data-unidad') || 'unidad';
                const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);
                const precioVenta = parseFloat(btn.getAttribute('data-precioventa') || '0');
                const ultimoCompra = btn.getAttribute('data-preciocompra');
                const precioCompraUlt = ultimoCompra === null || ultimoCompra === undefined || ultimoCompra === '' ? null : parseFloat(ultimoCompra);

                lineas.push({
                    ProductoId: id,
                    ProductoNombre: nombre,
                    UnidadMedida: unidad,
                    Cantidad: 1,
                    PrecioCompra: precioCompraUlt,
                    UltimoPrecioCompra: precioCompraUlt,
                    PrecioVenta: isNaN(precioVenta) ? 0 : precioVenta,
                    StockActual: isNaN(stock) ? 0 : stock
                });
                renderLineas();
            }

        function quitarLinea(productoId) {
            const idx = lineas.findIndex(x => x.ProductoId === productoId);
            if (idx >= 0) {
                lineas.splice(idx, 1);
                renderLineas();
            }
        }

        function actualizarCantidad(input) {
            const idx = parseInt(input.getAttribute('data-idx') || '-1', 10);
            if (idx < 0 || idx >= lineas.length) return;
            let val = parseInt(input.value || '0', 10);
            if (isNaN(val) || val < 1) val = 1;
            lineas[idx].Cantidad = val;
            input.value = val;
        }

        function actualizarPrecio(input) {
            const idx = parseInt(input.getAttribute('data-idx') || '-1', 10);
            if (idx < 0 || idx >= lineas.length) return;
            let val = parseFloat(input.value);
            if (isNaN(val) || val < 0) {
                lineas[idx].PrecioCompra = null;
                input.value = '';
                return;
            }
            lineas[idx].PrecioCompra = val;
        }

        function esIngresoActivo() {
            if (!tipoMovimientoSelect) return true;
            return (tipoMovimientoSelect.value || 'INGRESO').toUpperCase() === 'INGRESO';
        }

        function aplicarTipoMovimientoEnUI() {
            const esIngreso = esIngresoActivo();
            const precioInputs = tbodyCargas ? tbodyCargas.querySelectorAll('input[name$=".PrecioCompra"]') : [];
            precioInputs.forEach(input => {
                input.disabled = !esIngreso;
                if (!esIngreso) {
                    const idx = parseInt(input.getAttribute('data-idx') || '-1', 10);
                    if (!isNaN(idx) && idx >= 0 && idx < lineas.length) {
                        lineas[idx].PrecioCompra = null;
                    }
                    input.value = '';
                }
            });
            if (btnConfirmar) {
                btnConfirmar.textContent = esIngreso ? 'Registrar ingresos' : 'Registrar egresos';
            }
            if (tipoMovimientoInfo) {
                tipoMovimientoInfo.textContent = esIngreso
                    ? 'Cada linea se registrara como un ingreso de stock.'
                    : 'Cada linea se registrara como un egreso de stock.';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderLineas();
            aplicarTipoMovimientoEnUI();
            if (tipoMovimientoSelect) {
                if (tipoMovimientoInicial) {
                    tipoMovimientoSelect.value = tipoMovimientoInicial;
                }
                aplicarTipoMovimientoEnUI();
                tipoMovimientoSelect.addEventListener('change', () => {
                    aplicarTipoMovimientoEnUI();
                });
            }

            const inputBusqueda = document.getElementById('buscadorProductos');
            const tbodyProductos = document.getElementById('productosBody');
            const paginacion = document.getElementById('paginacionProductos');
            const urlBuscarProductos = '@Url.Action("BuscarProductos", "Stock")';
            const htmlOriginalProductos = tbodyProductos ? tbodyProductos.innerHTML : '';
            let buscadorTimeoutId = null;

            if (inputBusqueda && tbodyProductos && urlBuscarProductos) {
                inputBusqueda.addEventListener('input', () => {
                    const termino = (inputBusqueda.value || '').trim();

                    if (buscadorTimeoutId) {
                        clearTimeout(buscadorTimeoutId);
                    }

                    buscadorTimeoutId = setTimeout(() => {
                        if (termino.length === 0) {
                            tbodyProductos.innerHTML = htmlOriginalProductos;
                            if (paginacion) paginacion.style.display = '';
                            return;
                        }

                        if (paginacion) paginacion.style.display = 'none';

                        fetch(urlBuscarProductos + '?q=' + encodeURIComponent(termino))
                            .then(r => r.ok ? r.json() : [])
                            .then(data => {
                                if (!Array.isArray(data)) return;
                                tbodyProductos.innerHTML = '';
                                data.forEach(p => {
                                    const tr = document.createElement('tr');
                                    const unidad = p.unidad || 'unidad';
                                    const stock = typeof p.stock === 'number' ? p.stock : 0;
                                    const stockMinimo = typeof p.stockMinimo === 'number' ? p.stockMinimo : 0;
                                    const esCritico = p.stockCritico === true || (stockMinimo > 0 && stock <= stockMinimo);
                                    const precioVenta = typeof p.precioVenta === 'number' ? p.precioVenta : 0;
                                    const precioCompra = typeof p.precioCompra === 'number' ? p.precioCompra : null;
                                    tr.className = 'transition-colors ' + (esCritico ? 'bg-amber-50/50 hover:bg-amber-100' : 'hover:bg-gray-50');
                                    tr.innerHTML = `
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">${p.id}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 font-mono text-xs">${p.sku || ''}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">${p.nombre || ''}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">${unidad}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">${stock}${esCritico ? ' <span class="ml-2 inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Crítico</span>' : ''}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900">$ ${precioVenta ? precioVenta.toFixed(2) : '-'}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">${(typeof precioCompra === 'number') ? precioCompra.toFixed(2) : '-'}</td>
                                        <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                            <button type="button"
                                                    class="btn-producto inline-flex items-center rounded-md px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors"
                                                    style="background-color:#FC651F;"
                                                    onmouseover="this.style.backgroundColor='#e0541a'" onmouseout="this.style.backgroundColor='#FC651F'"
                                                    data-id="${p.id}"
                                                    data-sku="${p.sku || ''}"
                                                    data-nombre="${p.nombre || ''}"
                                                    data-unidad="${unidad}"
                                                    data-stock="${stock}"
                                                    data-critico="${esCritico}"
                                                    data-precioventa="${precioVenta}"
                                                    data-preciocompra="${(typeof precioCompra === 'number') ? precioCompra : ''}"
                                                    onclick="agregarProductoDesdeBoton(this)">
                                                Modificar
                                            </button>
                                        </td>`;
                                    tbodyProductos.appendChild(tr);
                                });
                            })
                            .catch(() => { /* ignorar errores de red */ });
                    }, 300);
                });
            }
        });
    </script>
}
