@model mi_ferreteria.ViewModels.ImportarProductosResultadoViewModel

<div class="space-y-4">
    <div class="grid grid-cols-3 gap-3">
        <div class="bg-green-50 border border-green-200 rounded-lg p-3 text-center">
            <p class="text-2xl font-bold text-green-700">@Model.TotalCreados</p>
            <p class="text-xs text-green-600 mt-0.5">Creados</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-center">
            <p class="text-2xl font-bold text-blue-700">@Model.TotalActualizados</p>
            <p class="text-xs text-blue-600 mt-0.5">Actualizados</p>
        </div>
        <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-center">
            <p class="text-2xl font-bold text-red-700">@Model.TotalErrores</p>
            <p class="text-xs text-red-600 mt-0.5">Errores</p>
        </div>
    </div>

    @if (Model.Resultados.Any())
    {
        <div class="overflow-auto max-h-72 rounded-lg border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200 text-xs">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-3 py-2 text-left font-semibold text-gray-700">Fila</th>
                        <th class="px-3 py-2 text-left font-semibold text-gray-700">Nombre</th>
                        <th class="px-3 py-2 text-left font-semibold text-gray-700">Código</th>
                        <th class="px-3 py-2 text-left font-semibold text-gray-700">Estado</th>
                        <th class="px-3 py-2 text-left font-semibold text-gray-700">Detalle</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var r in Model.Resultados)
                    {
                        <tr>
                            <td class="px-3 py-2 text-gray-400 font-mono">@r.Fila</td>
                            <td class="px-3 py-2 text-gray-900">@(r.Nombre ?? "-")</td>
                            <td class="px-3 py-2 text-gray-500 font-mono">@(r.CodigoBarra ?? "-")</td>
                            <td class="px-3 py-2">
                                @if (r.Estado == "creado")
                                {
                                    <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Creado</span>
                                }
                                else if (r.Estado == "actualizado")
                                {
                                    <span class="inline-flex rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">Actualizado</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Error</span>
                                }
                            </td>
                            <td class="px-3 py-2 text-gray-500">@r.Mensaje</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-sm text-gray-500 text-center py-4">El archivo no contenía filas de datos.</p>
    }

    <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="cerrarModalImportar()"
                class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
            Cerrar
        </button>
        <button type="button" onclick="volverFormularioImportar()"
                class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            Importar otro archivo
        </button>
    </div>
</div>
