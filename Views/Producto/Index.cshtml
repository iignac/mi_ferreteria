    panel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
    panel.classList.add('opacity-0', 'translate-y-4', 'sm:scale-95');
    setTimeout(() => {
        modal.classList.add('hidden');
        document.getElementById('lista-precios-file-input').value = '';
        document.getElementById('modal-lista-precios-error').classList.add('hidden');
        document.getElementById('modal-lista-precios-form').classList.remove('hidden');
        document.getElementById('modal-lista-precios-resultado').classList.add('hidden');
        document.getElementById('modal-lista-precios-resultado').innerHTML = '';
    }, 250);
}

function volverFormularioListaPrecios() {
    document.getElementById('modal-lista-precios-form').classList.remove('hidden');
    document.getElementById('modal-lista-precios-resultado').classList.add('hidden');
    document.getElementById('modal-lista-precios-resultado').innerHTML = '';
    document.getElementById('lista-precios-file-input').value = '';
    document.getElementById('modal-lista-precios-error').classList.add('hidden');
}

function enviarListaPrecios() {
    const fileInput = document.getElementById('lista-precios-file-input');
    const errorDiv = document.getElementById('modal-lista-precios-error');
    const btn = document.getElementById('modal-lista-precios-btn');
    const spinner = document.getElementById('modal-lista-precios-spinner');

    errorDiv.classList.add('hidden');

    if (!fileInput.files || fileInput.files.length === 0) {
        errorDiv.textContent = 'Seleccioná un archivo .xlsx antes de importar.';
        errorDiv.classList.remove('hidden');
        return;
    }
    if (!fileInput.files[0].name.endsWith('.xlsx')) {
        errorDiv.textContent = 'El archivo debe ser formato .xlsx.';
        errorDiv.classList.remove('hidden');
        return;
    }

    const formData = new FormData();
    formData.append('Archivo', fileInput.files[0]);
    const token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (token) formData.append('__RequestVerificationToken', token.value);

    btn.disabled = true;
    spinner.classList.remove('hidden');

    fetch('@Url.Action("ImportarListaPrecios")', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(async res => {
        btn.disabled = false;
        spinner.classList.add('hidden');
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            errorDiv.innerHTML = (data.error || 'Error al procesar el archivo.').replace(/\n/g, '<br>');
            errorDiv.classList.remove('hidden');
            return;
        }
        const html = await res.text();
        document.getElementById('modal-lista-precios-form').classList.add('hidden');
        const resultado = document.getElementById('modal-lista-precios-resultado');
        resultado.innerHTML = html;
        resultado.classList.remove('hidden');
    })
    .catch(() => {
        btn.disabled = false;
        spinner.classList.add('hidden');
        errorDiv.textContent = 'Error de conexión al enviar el archivo.';
        errorDiv.classList.remove('hidden');
    });
}

function setupAjaxForm(form) {
    if (!form) return;
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        if (window.jQuery && window.jQuery(form).valid && !window.jQuery(form).valid()) {
            return;
        }

        const formData = new FormData(form);
        const url = form.getAttribute('action');
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Guardando...';
        }

        fetch(url, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(async res => {
            const contentType = res.headers.get("content-type");
            if (contentType && contentType.indexOf("application/json") !== -1) {
                const data = await res.json();
                if (data.success) {
                    closeAjaxModal();
                    window.location.reload();
                }
            } else {
                const html = await res.text();
                const body = document.getElementById('ajax-modal-body');
                body.innerHTML = html;
                setupAjaxForm(body.querySelector('form'));
            }
        })
        .catch(err => {
            console.error('Error submitting form', err);
            if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalText; }
        });
    });
}

</script>
}
