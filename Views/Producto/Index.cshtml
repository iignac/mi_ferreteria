@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
document.addEventListener('DOMContentLoaded', function(){
  // Confirmación de eliminación desde el listado
  document.querySelectorAll('.btn-delete-prod').forEach(function(a){
    a.addEventListener('click', function(e){
    if(!confirm('¿Seguro que deseas eliminar este producto?')){
        e.preventDefault();
      }
    });
  });

  // Click en fila -> navega a Detalle
  document.querySelectorAll('table.table-products tbody tr.clickable-row').forEach(function(tr){
    tr.addEventListener('click', function(e){
      var t = e.target;
      if (t && t.closest && (t.closest('a') || t.closest('button') || t.closest('form'))) return;
      var href = this.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });

  // Búsqueda con debounce
  const qInput = document.querySelector('form[method="get"] input[name="q"]');
  const form = qInput && qInput.closest('form');
  if (qInput && form) {
    let timer;
    qInput.addEventListener('input', function(){
      clearTimeout(timer);
      const pageField = form.querySelector('input[name="page"]');
      if (pageField) pageField.value = '1';
      timer = setTimeout(() => { form.requestSubmit(); }, 300);
    });
  }

  // Click outside to close modal
  document.getElementById('ajax-modal-container').addEventListener('click', function(e) {
      if (e.target === document.querySelector('.fixed.inset-0.z-50.overflow-y-auto > div')) {
          closeAjaxModal();
      }
  });
});

function openAjaxModal(url) {
    const container = document.getElementById('ajax-modal-container');
    const backdrop = document.getElementById('ajax-modal-backdrop');
    const content = document.getElementById('ajax-modal-content');
    const body = document.getElementById('ajax-modal-body');
    const loading = document.getElementById('ajax-modal-loading');

    body.innerHTML = '';
    body.classList.add('hidden');
    loading.classList.remove('hidden');

    container.classList.remove('hidden');
    setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        content.classList.remove('opacity-0', 'translate-y-4', 'sm:scale-95');
        content.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
    }, 10);

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(res => res.text())
    .then(html => {
        loading.classList.add('hidden');
        body.innerHTML = html;
        body.classList.remove('hidden');
        
        if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
            const form = body.querySelector('form');
            if (form) window.jQuery.validator.unobtrusive.parse(form);
        }

        Array.from(body.querySelectorAll('script')).forEach(oldScript => {
            const newScript = document.createElement('script');
            Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
            newScript.appendChild(document.createTextNode(oldScript.innerHTML));
            oldScript.parentNode.replaceChild(newScript, oldScript);
        });

        setupAjaxForm(body.querySelector('form'));
    })
    .catch(err => {
        console.error('Error fetching modal content', err);
        body.innerHTML = '<div class="p-4 bg-red-50 text-red-700 rounded-md">Error cargando contenido.</div>';
        loading.classList.add('hidden');
        body.classList.remove('hidden');
    });
}

function closeAjaxModal() {
    const container = document.getElementById('ajax-modal-container');
    const backdrop = document.getElementById('ajax-modal-backdrop');
    const content = document.getElementById('ajax-modal-content');

    backdrop.classList.add('opacity-0');
    content.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
    content.classList.add('opacity-0', 'translate-y-4', 'sm:scale-95');
    
    setTimeout(() => { container.classList.add('hidden'); }, 300);
}

// ---- Modal Importar Excel ----
function abrirModalImportar() {
    const modal = document.getElementById('modal-importar');
    const backdrop = document.getElementById('modal-importar-backdrop');
    const panel = document.getElementById('modal-importar-panel');
    modal.classList.remove('hidden');
    setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        panel.classList.remove('opacity-0', 'translate-y-4', 'sm:scale-95');
        panel.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
    }, 10);
}

function cerrarModalImportar() {
    const modal = document.getElementById('modal-importar');
    const backdrop = document.getElementById('modal-importar-backdrop');
    const panel = document.getElementById('modal-importar-panel');
    backdrop.classList.add('opacity-0');
    panel.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
    panel.classList.add('opacity-0', 'translate-y-4', 'sm:scale-95');
    setTimeout(() => {
        modal.classList.add('hidden');
        // Resetear estado
        document.getElementById('importar-file-input').value = '';
        document.getElementById('modal-importar-error').classList.add('hidden');
        document.getElementById('modal-importar-form').classList.remove('hidden');
        document.getElementById('modal-importar-resultado').classList.add('hidden');
        document.getElementById('modal-importar-resultado').innerHTML = '';
    }, 250);
}

function volverFormularioImportar() {
    document.getElementById('modal-importar-form').classList.remove('hidden');
    document.getElementById('modal-importar-resultado').classList.add('hidden');
    document.getElementById('modal-importar-resultado').innerHTML = '';
    document.getElementById('importar-file-input').value = '';
    document.getElementById('modal-importar-error').classList.add('hidden');
}

function enviarImportarExcel() {
    const fileInput = document.getElementById('importar-file-input');
    const errorDiv = document.getElementById('modal-importar-error');
    const btn = document.getElementById('modal-importar-btn');
    const spinner = document.getElementById('modal-importar-spinner');

    errorDiv.classList.add('hidden');

    if (!fileInput.files || fileInput.files.length === 0) {
        errorDiv.textContent = 'Seleccioná un archivo .xlsx antes de importar.';
        errorDiv.classList.remove('hidden');
        return;
    }
    if (!fileInput.files[0].name.endsWith('.xlsx')) {
        errorDiv.textContent = 'El archivo debe ser formato .xlsx.';
        errorDiv.classList.remove('hidden');
        return;
    }

    const formData = new FormData();
    formData.append('Archivo', fileInput.files[0]);
    // Anti-forgery token
    const token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (token) formData.append('__RequestVerificationToken', token.value);

    btn.disabled = true;
    spinner.classList.remove('hidden');

    fetch('@Url.Action("ImportarExcel")', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(async res => {
        btn.disabled = false;
        spinner.classList.add('hidden');
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            errorDiv.innerHTML = (data.error || 'Error al procesar el archivo.').replace(/\n/g, '<br>');
            errorDiv.classList.remove('hidden');
            return;
        }
        const html = await res.text();
        document.getElementById('modal-importar-form').classList.add('hidden');
        const resultado = document.getElementById('modal-importar-resultado');
        resultado.innerHTML = html;
        resultado.classList.remove('hidden');
    })
    .catch(() => {
        btn.disabled = false;
        spinner.classList.add('hidden');
        errorDiv.textContent = 'Error de conexión al enviar el archivo.';
        errorDiv.classList.remove('hidden');
    });
}

// Agregar token antiforgery oculto para el modal de importar
document.addEventListener('DOMContentLoaded', function() {
    const existingToken = document.querySelector('form input[name="__RequestVerificationToken"]');
    if (existingToken) {
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = '__RequestVerificationToken';
        hidden.id = 'importar-antiforgery';
        hidden.value = existingToken.value;
        document.getElementById('modal-importar').appendChild(hidden);
    }
});

// ---- Modal Lista de Precios Proveedor ----
function abrirModalListaPrecios() {
