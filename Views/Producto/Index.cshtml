@model IEnumerable<mi_ferreteria.Models.Producto>
@using mi_ferreteria.ViewModels
@using System.Linq
@{
    ViewData["Title"] = "Productos";
}

@{
    string q = ViewBag.Query as string ?? string.Empty;
    string sort = ViewBag.Sort as string ?? "id_asc";
    bool canManageProductos = User.IsInRole("Administrador") || User.IsInRole("Stock");
    
    string NextSort(string col) {
        return col switch {
            "id" => sort == "id_asc" ? "id_desc" : "id_asc",
            "nombre" => sort == "nombre_asc" ? "nombre_desc" : "nombre_asc",
            "precio" => sort == "precio_asc" ? "precio_desc" : "precio_asc",
            "stock" => sort == "stock_asc" ? "stock_desc" : "stock_asc",
            _ => "id_asc"
        };
    }
    string Arrow(string col) {
        if (col == "id" && sort.StartsWith("id_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "nombre" && sort.StartsWith("nombre_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "precio" && sort.StartsWith("precio_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "stock" && sort.StartsWith("stock_")) return sort.EndsWith("asc") ? "↑" : "↓";
        return "↕";
    }

    var stocks = ViewBag.Stocks as System.Collections.Generic.IDictionary<long, long>;
    var stockCriticos = ViewBag.StockCriticos as System.Collections.Generic.HashSet<long> ?? new System.Collections.Generic.HashSet<long>();
    var detalleCriticos = ViewBag.StockCriticosDetalle as System.Collections.Generic.List<StockCriticoViewModel> ?? new System.Collections.Generic.List<StockCriticoViewModel>();
    var totalCriticos = ViewBag.StockCriticosCount is int sc ? sc : detalleCriticos.Count;

    int page = ViewBag.Page is int ? (int)ViewBag.Page : 1;
    int totalPages = ViewBag.TotalPages is int ? (int)ViewBag.TotalPages : 1;
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Productos
        </h2>
        <p class="mt-2 text-sm text-gray-700">Gestione el catálogo de productos, precios y niveles de inventario.</p>
    </div>
    @if (canManageProductos)
    {
        <div class="mt-4 sm:ml-16 sm:mt-0 flex gap-2">
            <button type="button" onclick="abrirModalListaPrecios()" class="btn-action-secondary">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                </svg>
                Lista de precios
            </button>
            <button type="button" onclick="abrirModalImportar()" class="btn-action-secondary">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Importar productos
            </button>
            <button type="button" onclick="openAjaxModal('@Url.Action("Create", new { page = page })')" class="btn-primary">
                Crear producto
            </button>
        </div>
    }
</div>

@if (ViewBag.LoadError == true)
{
    <div class="rounded-md bg-red-50 p-4 mb-6 border border-red-200">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">Error al cargar</h3>
                <div class="mt-2 text-sm text-red-700">
                    <p>No pudimos cargar los productos. Por favor, intenta un poco mas tarde.</p>
                </div>
            </div>
        </div>
    </div>
}
else if (totalCriticos > 0)
{
    var resumen = string.Join(", ", detalleCriticos.Take(4).Select(d => d.Nombre));
    if (detalleCriticos.Count > 4)
    {
        resumen += $" y {detalleCriticos.Count - 4} más";
    }
    <a asp-controller="Stock" asp-action="Criticos" class="block rounded-md bg-amber-50 p-4 mb-6 border border-amber-200 hover:bg-amber-100 transition-colors no-underline">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium text-amber-800">Atención: @totalCriticos producto@(totalCriticos == 1 ? "" : "s") en stock crítico.</h3>
                    <div class="mt-1 text-sm text-amber-700">
                        <p>@resumen</p>
                    </div>
                </div>
                <span class="inline-flex items-center rounded-md bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800 uppercase">Prioridad stock</span>
            </div>
        </div>
    </a>
}

<div class="mb-6 bg-white p-4 shadow-sm rounded-lg border border-gray-200">
    <form method="get" asp-action="Index" class="flex items-center gap-2">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="sort" value="@sort" />
        <div class="relative flex-1">
            <input type="search" name="q" id="search" value="@q"
                   class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-4 pr-10 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]"
                   placeholder="Buscar por cualquier dato (SKU, nombre, descripción...)" />
        </div>
        <button type="submit"
                class="group flex items-center justify-center rounded-lg bg-gray-900 p-2.5 text-white shadow-sm transition-colors duration-200 hover:bg-[#FC651F] focus:outline-none focus:ring-2 focus:ring-[#FC651F] focus:ring-offset-1"
                title="Buscar">
            <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
            </svg>
        </button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="Index" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900">
                Limpiar
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="rounded-md bg-blue-50 p-4 shadow-sm border border-blue-100">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1 md:flex md:justify-between">
                <p class="text-sm text-blue-700">No hay productos cargados o no coinciden con la búsqueda.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="mt-4 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 table-products">
                        <thead>
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-white sm:pl-6 w-20">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("id")' asp-route-page="1" class="group inline-flex hover:text-white/80">ID <span class="ml-1 text-white/60">@Html.Raw(Arrow("id"))</span></a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">SKU</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("nombre")' asp-route-page="1" class="group inline-flex hover:text-white/80">Nombre <span class="ml-1 text-white/60">@Html.Raw(Arrow("nombre"))</span></a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("precio")' asp-route-page="1" class="group inline-flex hover:text-white/80">Precio <span class="ml-1 text-white/60">@Html.Raw(Arrow("precio"))</span></a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Ubicación</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("stock")' asp-route-page="1" class="group inline-flex hover:text-white/80">Stock <span class="ml-1 text-white/60">@Html.Raw(Arrow("stock"))</span></a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-white">Activo</th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-white">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var p in Model)
                            {
                                var stockActual = (stocks != null && stocks.ContainsKey(p.Id)) ? stocks[p.Id] : 0;
                                var esCritico = stockCriticos.Contains(p.Id);
                                var rowClasses = "clickable-row cursor-pointer transition-colors " + (esCritico ? "bg-amber-50/50 hover:bg-amber-100" : "hover:bg-gray-50");
                                
                                <tr class="@rowClasses" data-href="@Url.Action("Details","Producto", new { id = p.Id, page = page, q = q, sort = sort })">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">@p.Id</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 font-mono text-xs">@p.Sku</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">@p.Nombre</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900">$ @p.PrecioVentaActual</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">@(string.IsNullOrWhiteSpace(p.UbicacionCodigo) ? "-" : p.UbicacionCodigo)</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900 font-medium">
                                        @stockActual
                                        @if (esCritico)
                                        {
                                            <span class="ml-2 inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Crítico</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-center">
                                        @if (p.Activo)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">No</span>
                                        }
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex items-center justify-end gap-2">
                                            <a asp-action="Details" asp-route-id="@p.Id" asp-route-page="@(page)" asp-route-q="@q"  asp-route-sort="@sort" class="text-indigo-600 hover:text-indigo-900 px-2">Ver</a>
                                            @if (canManageProductos)
                                            {
                                                <button type="button" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("Edit", new { id = p.Id, page = page, q = q, sort = sort })')" class="tbl-link-edit">Editar</button>
                                            }
                                            <a asp-controller="StockProducto" asp-action="Manage" asp-route-id="@p.Id" class="text-gray-600 hover:text-gray-900 px-2">Stock</a>
                                            @if (canManageProductos)
                                            {
                                                <a asp-action="Delete" asp-route-id="@p.Id" asp-route-page="@(page)" asp-route-q="@q"  asp-route-sort="@sort" class="tbl-link-delete btn-delete-prod">Eliminar</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        var start = Math.Max(1, page - 2);
        var end = Math.Min(totalPages, page + 2);
        
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-6 shadow sm:rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Página <span class="font-medium">@(page)</span> de <span class="font-medium">@totalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 focus:outline-offset-0 @(page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                            <span class="sr-only">Anterior</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                            </svg>
                        </a>

                        @for (var i = start; i <= end; i++)
                        {
                            if (i == page)
                            {
                                <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-page="@i" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 focus:outline-offset-0 @(page >= totalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                            <span class="sr-only">Siguiente</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
}

    <!-- Modal Importar Excel -->
    <div id="modal-importar" class="relative z-50 hidden" role="dialog" aria-modal="true">
        <div id="modal-importar-backdrop" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity opacity-0 z-50"></div>
        <div class="fixed inset-0 z-50 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div id="modal-importar-panel" class="relative w-full max-w-2xl transform rounded-xl bg-white shadow-xl transition-all opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">

                    <!-- Header -->
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                        <h3 class="text-base font-semibold text-gray-900">Importar productos desde Excel</h3>
                        <button type="button" onclick="cerrarModalImportar()" class="rounded-md text-gray-400 hover:text-gray-500">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>

                    <!-- Formulario -->
                    <div id="modal-importar-form" class="px-6 py-5 space-y-5">
                        <div class="flex items-center justify-between rounded-md bg-amber-50 border border-amber-200 p-3">
                            <p class="text-xs text-amber-800"><strong>Columnas (A→J):</strong> Nombre* | CodigoBarra* | Precio* | Cantidad* | SKU | Descripcion | Categoria | StockMinimo | UnidadMedida | Ubicacion</p>
                            <a href="@Url.Action("DescargarPlantillaImportacion")" class="ml-3 shrink-0 inline-flex items-center gap-1 rounded bg-amber-100 hover:bg-amber-200 px-2 py-1 text-xs font-medium text-amber-800 transition-colors">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                                Plantilla
                            </a>
                        </div>

                        <div x-data="{ fileName: '', dragging: false }"
                             x-on:dragover.prevent="dragging = true"
                             x-on:dragleave.prevent="dragging = false"
                             x-on:drop.prevent="dragging = false; const f = $event.dataTransfer.files[0]; if(f){ fileName = f.name; document.getElementById('importar-file-input').files = $event.dataTransfer.files; }"
                             :class="dragging ? 'border-indigo-400 bg-indigo-50' : 'border-gray-300 bg-gray-50'"
                             class="flex flex-col items-center justify-center border-2 border-dashed rounded-xl p-8 transition-colors cursor-pointer"
                             onclick="document.getElementById('importar-file-input').click()">
                            <svg class="h-8 w-8 text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                            </svg>
                            <p class="text-sm text-gray-600" x-text="fileName || 'Hacé clic o arrastrá tu archivo .xlsx aquí'"></p>
                            <p class="text-xs text-gray-400 mt-1" x-show="!fileName">Solo archivos .xlsx</p>
                            <input id="importar-file-input" type="file" accept=".xlsx" class="sr-only"
                                   x-on:change="fileName = $event.target.files[0]?.name ?? ''" />
                        </div>

                        <div id="modal-importar-error" class="hidden rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700"></div>

                        <div class="flex justify-end gap-3">
                            <button type="button" onclick="cerrarModalImportar()"
                                    class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                                Cancelar
                            </button>
