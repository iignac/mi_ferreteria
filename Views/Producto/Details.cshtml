@model mi_ferreteria.Models.Producto
@{
    ViewData["Title"] = "Detalle de Producto";
    var barcodes = ViewBag.Barcodes as IEnumerable<mi_ferreteria.Models.ProductoCodigoBarra> ?? Enumerable.Empty<mi_ferreteria.Models.ProductoCodigoBarra>();
    var stock = ViewBag.Stock is long l ? l : 0;
    var returnPage = ViewBag.ReturnPage is int ? (int)ViewBag.ReturnPage : 1;
    var cats = ViewBag.CategoriasNombres as IEnumerable<string>;
    var canManageProductos = User.IsInRole("Administrador") || User.IsInRole("Stock");
}

<div class="md:flex md:items-center md:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Detalle de Producto
        </h2>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0">
        <a asp-action="Index" asp-route-page="@returnPage" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Volver</a>
        @if (canManageProductos)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-page="@returnPage" class="btn-primary ml-3">Editar</a>
        }
    </div>
</div>

<div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="px-4 py-6 sm:px-6">
        <h3 class="text-base font-semibold leading-7 text-gray-900">Información del Producto</h3>
        <p class="mt-1 max-w-2xl text-sm leading-6 text-gray-500">SKU: <span class="font-mono text-gray-900">@Model.Sku</span></p>
    </div>
    <div class="border-t border-gray-100">
        <dl class="divide-y divide-gray-100">
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Nombre</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">@Model.Nombre</dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Categorías</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
                    @if (cats != null && cats.Any())
                    {
                        <div class="flex flex-wrap gap-2">
                        @foreach (var n in cats)
                        {
                            <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">@n</span>
                        }
                        </div>
                    }
                    else
                    {
                        <span class="text-gray-400">Sin categorías</span>
                    }
                </dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-gray-50">
                <dt class="text-sm font-medium text-gray-900">Precio</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-900 font-semibold sm:col-span-2 sm:mt-0">$ @Model.PrecioVentaActual</dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Stock Actual</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
                    <span class="font-medium @(stock <= Model.StockMinimo ? "text-red-600" : "text-gray-900")">@stock</span> 
                    <span class="text-gray-500">(Mínimo: @Model.StockMinimo)</span>
                </dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Unidad de medida</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">@(string.IsNullOrWhiteSpace(Model.UnidadMedida) ? "-" : Model.UnidadMedida)</dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Ubicación física</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">@(string.IsNullOrWhiteSpace(Model.UbicacionCodigo) ? "-" : Model.UbicacionCodigo)</dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-900">Estado</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
                    @if (Model.Activo)
                    {
                        <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Activo</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactivo</span>
                    }
                </dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-gray-50">
                <dt class="text-sm font-medium text-gray-900">Trazabilidad</dt>
                <dd class="mt-1 text-sm leading-6 text-gray-500 sm:col-span-2 sm:mt-0">
                    Creado: @Model.CreatedAt.LocalDateTime <br/>
                    Actualizado: @Model.UpdatedAt.LocalDateTime
                </dd>
            </div>
            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium leading-6 text-gray-900">Códigos de Barra</dt>
                <dd class="mt-2 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                    @if (!barcodes.Any())
                    {
                        <span class="text-gray-400">Sin códigos de barra registrados.</span>
                    }
                    else
                    {
                        <ul role="list" class="divide-y divide-gray-100 rounded-md border border-gray-200">
                            @foreach (var bc in barcodes)
                            {
                                <li class="flex items-center justify-between py-4 pl-4 pr-5 text-sm leading-6 hover:bg-gray-50">
                                    <div class="flex w-0 flex-1 items-center">
                                        <svg class="h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 5h2v14H3zM7 5h2v14H7zM11 5h1v14h-1zM14 5h2v14h-2zM18 5h3v14h-3z"></path>
                                        </svg>
                                        <div class="ml-4 flex min-w-0 flex-1 gap-2">
                                            <span class="truncate font-medium font-mono">@bc.CodigoBarra</span>
                                            <span class="flex-shrink-0 text-gray-400">@bc.Tipo</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </dd>
            </div>
        </dl>
    </div>
</div>
