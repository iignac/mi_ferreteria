@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-full flex items-center justify-center py-8">
    <div class="w-full max-w-md">

        <!-- Card -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">

            <!-- Header oscuro con branding -->
            <div class="bg-[#060304] px-8 py-8 text-center">
                <div class="flex items-center justify-center gap-3 mb-2">
                    <div class="bg-[#FC651F] rounded-lg p-2">
                        <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-white tracking-tight">mi_Ferreteria</span>
                </div>
                <p class="text-white/50 text-sm">Sistema de gestión</p>
            </div>

            <!-- Formulario -->
            <div class="px-8 py-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6">Ingresá a tu cuenta</h2>

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                    {
                        <div class="mb-5 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-start gap-2">
                            <svg class="h-4 w-4 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <!-- Email -->
                    <div class="mb-5">
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                        <input asp-for="Email"
                               class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm outline-none transition focus:border-[#FC651F] focus:ring-2 focus:ring-[#FC651F]/20"
                               autocomplete="username"
                               placeholder="usuario@ejemplo.com" />
                        <span asp-validation-for="Email" class="mt-1 text-xs text-red-600"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-5" x-data="{ show: false }">
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                        <div class="relative">
                            <input asp-for="Password"
                                   :type="show ? 'text' : 'password'"
                                   class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 pr-11 text-sm text-gray-900 placeholder-gray-400 shadow-sm outline-none transition focus:border-[#FC651F] focus:ring-2 focus:ring-[#FC651F]/20"
                                   autocomplete="current-password"
                                   placeholder="••••••••" />
                            <button type="button"
                                    @@click="show = !show"
                                    class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-600 transition-colors"
                                    :aria-label="show ? 'Ocultar contraseña' : 'Mostrar contraseña'">
                                <!-- Ojo abierto -->
                                <svg x-show="!show" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                <!-- Ojo cerrado -->
                                <svg x-show="show" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" x-cloak>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="mt-1 text-xs text-red-600"></span>
                    </div>

                    <!-- Recordar sesión -->
                    <div class="flex items-center mb-6">
                        <input asp-for="RememberMe"
                               class="h-4 w-4 rounded border-gray-300 accent-[#FC651F] cursor-pointer" />
                        <label asp-for="RememberMe" class="ml-2.5 text-sm text-gray-600 cursor-pointer select-none">Mantener sesión iniciada</label>
                    </div>

                    <!-- Botón -->
                    <button type="submit"
                            class="w-full rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:opacity-90 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#FC651F]"
                            style="background-color: #FC651F;">
                        Ingresar
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
