@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-1 text-danger"><i class="bi bi-shield-x"></i></h1>
        <h2 class="mb-3">Desautorizado</h2>
