@model mi_ferreteria.ViewModels.VentaCrearViewModel
@using mi_ferreteria.Models
@using mi_ferreteria.ViewModels
@using System.Linq
@{
    ViewData["Title"] = "Gestión de Ventas";

    string q = ViewBag.Query as string ?? string.Empty;
    var productos = ViewBag.Productos as IEnumerable<Producto> ?? Enumerable.Empty<Producto>();
    var stocks = ViewBag.Stocks as System.Collections.Generic.IDictionary<long, long> ?? new System.Collections.Generic.Dictionary<long, long>();
    var stockCriticos = ViewBag.StockCriticos as System.Collections.Generic.HashSet<long> ?? new System.Collections.Generic.HashSet<long>();
    var detalleCriticos = ViewBag.StockCriticosDetalle as System.Collections.Generic.List<StockCriticoViewModel> ?? new System.Collections.Generic.List<StockCriticoViewModel>();
    var totalCriticos = ViewBag.StockCriticosCount is int sc ? sc : detalleCriticos.Count;
    int page = ViewBag.Page is int pageValue ? pageValue : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Gestión de Ventas
        </h2>
    </div>
    <div class="mt-4 flex sm:ml-4 sm:mt-0">
        <a asp-action="Historial" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors">
            Ver historial de ventas
        </a>
    </div>
</div>

@if (TempData["VentaOk"] != null)
{
    <div class="rounded-md bg-green-50 p-4 mb-6 shadow-sm border border-green-200">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">@TempData["VentaOk"]</p>
            </div>
        </div>
    </div>
}

@if (TempData["VentaPendiente"] != null)
{
    <div class="rounded-md bg-yellow-50 p-4 mb-6 shadow-sm border border-yellow-200">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-yellow-800">@TempData["VentaPendiente"]</p>
            </div>
        </div>
    </div>
}

@if (totalCriticos > 0)
{
    var resumenCriticos = string.Join(", ", detalleCriticos.Take(4).Select(d => d.Nombre));
    if (detalleCriticos.Count > 4)
    {
        resumenCriticos += $" y {detalleCriticos.Count - 4} más";
    }
    <div class="rounded-md bg-yellow-50 p-4 mb-6 shadow-sm border border-yellow-200" id="alertaStockCriticoVenta">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-yellow-800">Atención: @totalCriticos producto@(totalCriticos == 1 ? "" : "s") en stock crítico (igual o por debajo del mínimo).</h3>
                <div class="mt-2 text-sm text-yellow-700">
                    <p>@resumenCriticos</p>
                </div>
            </div>
        </div>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Buscador y Selector de Productos (Lado Izquierdo) -->
    <div class="lg:col-span-7 space-y-6">
        <div class="bg-white shadow sm:rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
                <h3 class="text-base font-semibold leading-6 text-gray-900">Catálogo de Productos</h3>
                <p class="mt-1 max-w-2xl text-sm text-gray-500">Busque y seleccione los productos a vender.</p>
            </div>
            <div class="p-4 sm:p-6">
                <form method="get" asp-action="Index" class="mb-5 flex gap-3">
                    <div class="relative flex-grow">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <input type="search" id="buscadorProductos" name="q" value="@q" class="block w-full rounded-md border-0 py-2 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" placeholder="Buscar por SKU, nombre, descripción o código de barra" />
                    </div>
                    <input type="hidden" name="page" value="1" />
                    <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors">Buscar</button>
                    @if (!string.IsNullOrWhiteSpace(q))
                    {
                        <a asp-action="Index" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors">Limpiar</a>
                    }
                </form>

                @if (!productos.Any())
                {
                    <div class="text-center rounded-md bg-gray-50 p-6 border border-dashed border-gray-300">
                        <p class="text-sm text-gray-500">No hay productos para mostrar. Verifique su búsqueda.</p>
                    </div>
                }
                else
                {
                    <div class="flow-root">
                        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 px-4">
                            <div class="inline-block min-w-full py-2 align-middle">
                                <table class="min-w-full divide-y divide-gray-300 border border-gray-200 sm:rounded-lg">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500 sm:pl-3">SKU</th>
                                            <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Nombre</th>
                                            <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Precio</th>
                                            <th scope="col" class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Stock</th>
                                            <th scope="col" class="relative py-3 pl-3 pr-4 sm:pr-3 text-right">
                                                <span class="sr-only">Agregar</span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="productosBody" class="divide-y divide-gray-200 bg-white text-sm">
                                        @foreach (var p in productos)
                                        {
                                            var stock = stocks != null && stocks.TryGetValue(p.Id, out var s) ? s : 0;
                                            var esCritico = stockCriticos.Contains(p.Id);
                                            var trClass = esCritico ? "bg-red-50 hover:bg-red-100" : "hover:bg-gray-50";
                                            
                                            <tr class="@trClass transition-colors">
                                                <td class="whitespace-nowrap py-3 pl-4 pr-3 font-medium text-gray-900 sm:pl-3">@p.Sku</td>
                                                <td class="px-3 py-3 text-gray-900 truncate max-w-xs" title="@p.Nombre">@p.Nombre</td>
                                                <td class="whitespace-nowrap px-3 py-3 text-gray-500 font-medium">$ @p.PrecioVentaActual.ToString("N2")</td>
                                                <td class="whitespace-nowrap px-3 py-3 text-gray-500">
                                                    @stock
                                                    @if (esCritico)
                                                    {
                                                        <span class="ml-2 inline-flex items-center rounded-md bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Crítico</span>
                                                    }
                                                </td>
                                                <td class="relative whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-3">
                                                    <button type="button"
                                                            class="inline-flex items-center rounded bg-indigo-50 px-2 py-1 text-xs font-semibold text-indigo-600 shadow-sm hover:bg-indigo-100 transition-colors"
                                                            data-id="@p.Id"
                                                            data-sku="@p.Sku"
                                                            data-nombre="@p.Nombre"
                                                            data-precio="@p.PrecioVentaActual.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                            data-stock="@stock"
                                                            data-critico="@(esCritico ? "true" : "false")"
                                                            onclick="agregarAlCarritoDesdeBoton(this)">
                                                        Agregar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @if (totalPages > 1)
                    {
                        var start = System.Math.Max(1, page - 2);
                        var end = System.Math.Min(totalPages, page + 2);
                        <div id="paginacionProductos" class="flex items-center justify-between border-t border-gray-200 bg-white px-2 py-3 mt-4">
                            <div class="flex flex-1 justify-between sm:hidden">
                                <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 @(page <= 1 ? "pointer-events-none opacity-50" : "")">Anterior</a>
                                <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page + 1)" class="relative ml-2 inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 @(page >= totalPages ? "pointer-events-none opacity-50" : "")">Siguiente</a>
                            </div>
                            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                                <div><p class="text-sm text-gray-700">Página <span class="font-medium">@(page)</span> de <span class="font-medium">@totalPages</span></p></div>
                                <div>
                                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                                        <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 @(page <= 1 ? "pointer-events-none opacity-50" : "")">
                                            <span class="sr-only">Anterior</span>
                                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                                        </a>
                                        @for (var i = start; i <= end; i++)
                                        {
                                            if (i == page)
                                            {
                                                <span class="relative z-10 inline-flex items-center bg-indigo-600 px-3 py-2 text-sm font-semibold text-white focus:z-20">@i</span>
                                            }
                                            else
                                            {
                                                <a asp-action="Index" asp-route-q="@q" asp-route-page="@i" class="relative inline-flex items-center px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20">@i</a>
                                            }
                                        }
                                        <a asp-action="Index" asp-route-q="@q" asp-route-page="@(page + 1)" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 @(page >= totalPages ? "pointer-events-none opacity-50" : "")">
                                            <span class="sr-only">Siguiente</span>
                                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                                        </a>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div> <!-- Fin Venta Izquierda -->

    <!-- Carrito y Formulario (Lado Derecho) -->
    <div class="lg:col-span-5 space-y-6">
        @using (Html.BeginForm("Crear", "Venta", FormMethod.Post, new { @id = "frmVenta" }))
        {
            @Html.AntiForgeryToken()

            <div class="bg-white shadow sm:rounded-lg border border-gray-200 overflow-hidden sticky top-6">
                
                <!-- Sección de Carrito -->
                <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
                    <div>
                        <h3 class="text-base font-semibold leading-6 text-gray-900">Carrito de compras</h3>
                        <p class="mt-1 text-xs text-gray-500">Agregue al menos un producto.</p>
                    </div>
                    <button type="button" class="text-xs text-red-600 hover:text-red-900 font-medium" onclick="limpiarCarrito()">
                        Limpiar todo
                    </button>
                </div>
                
                <div class="p-0 sm:p-0">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th scope="col" class="py-2 pl-4 pr-3 text-left text-xs font-semibold text-gray-900">Producto / Precio</th>
                                    <th scope="col" class="px-2 py-2 text-center text-xs font-semibold text-gray-900">Cant. / Perm.</th>
                                    <th scope="col" class="relative py-2 pl-3 pr-4 text-right text-xs font-semibold text-gray-900"></th>
                                </tr>
                            </thead>
                            <tbody id="carritoBody" class="divide-y divide-gray-200 bg-white">
                                @for (var i = 0; i < Model.Lineas.Count; i++)
                                {
                                    <tr data-producto-id="@Model.Lineas[i].ProductoId" data-precio-unitario="@Model.Lineas[i].PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="hover:bg-gray-50">
                                        <td class="py-3 pl-4 pr-3 text-sm">
                                            <input type="hidden" name="Lineas[@i].ProductoId" value="@Model.Lineas[i].ProductoId" />
                                            <div class="font-medium text-gray-900 truncate max-w-[12rem]" title="@Model.Lineas[i].ProductoNombre">@Model.Lineas[i].ProductoNombre</div>
                                            <div class="text-gray-500 text-xs mt-1">
                                                <input type="hidden" name="Lineas[@i].PrecioUnitario" class="precio-unitario" value='@Model.Lineas[i].PrecioUnitario.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)' />
                                                $ @Model.Lineas[i].PrecioUnitario.ToString("0.00") (Disp: @Model.Lineas[i].StockDisponible)
                                            </div>
                                        </td>
                                        <td class="px-2 py-3 text-sm align-top">
                                            <div class="flex flex-col items-center gap-2">
                                                @Html.TextBoxFor(m => m.Lineas[i].Cantidad, new { @class = "block w-20 rounded-md border-0 py-1 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm cantidad-input text-center", type = "number", step = "1", min = "1" })
                                                
                                                <div class="flex items-center" title="Permitir venta sin stock">
                                                    @Html.CheckBoxFor(m => m.Lineas[i].PermitirVentaSinStock, new { @class = "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" })
                                                    <label class="ml-1 text-[10px] text-gray-500">Sin stock</label>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right text-sm font-medium align-middle">
                                            <button type="button" class="text-red-600 hover:text-red-900" onclick="quitarProductoDelCarrito(@Model.Lineas[i].ProductoId, this.closest('tr'));">
                                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Total -->
                <div class="px-4 py-4 sm:px-6 bg-indigo-50 border-t border-indigo-100 flex justify-between items-center">
                    <span class="text-base font-semibold text-indigo-900">Total a Pagar</span>
                    <span class="text-xl font-bold tracking-tight text-indigo-900" id="totalCarritoMonto">$ 0.00</span>
                </div>

                <!-- Sección de Pago y Cliente -->
                <div class="px-4 py-5 sm:px-6 border-t border-gray-200 bg-white">
                    <h4 class="text-sm font-semibold leading-6 text-gray-900 mb-4">Datos del cliente y facturación</h4>
                    
                    <div class="space-y-4">
                        <div>
                            <label asp-for="TipoCliente" class="block text-sm font-medium leading-6 text-gray-900">Tipo de Cliente</label>
                            <select asp-for="TipoCliente" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                <option value="CONSUMIDOR_FINAL">Consumidor final</option>
                                <option value="REGISTRADO">Cliente registrado</option>
                            </select>
                        </div>

                        <div id="grupoClienteRegistrado" class="rounded-md bg-gray-50 p-3 border border-gray-200 hidden">
                            <label asp-for="ClienteId" class="block text-sm font-medium leading-6 text-gray-900">Buscar Cliente</label>
                            <div class="mt-2 flex gap-2">
                                <select asp-for="ClienteId" class="block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6" asp-items="Model.Clientes">
                                    <option value="">-- Consumidor final --</option>
                                </select>
                                <a asp-controller="Cliente" asp-action="Create" target="_blank" class="inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" title="Crear nuevo cliente">
                                    ➕
                                </a>
                            </div>
                            <span asp-validation-for="ClienteId" class="text-xs text-red-600 mt-1 block"></span>
                        </div>

                        <div class="border-t border-gray-100 pt-4">
                            <label asp-for="TipoPago" class="block text-sm font-medium leading-6 text-gray-900">Forma de Pago</label>
                            <select asp-for="TipoPago" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                <option value="CONTADO">Contado</option>
                                <option value="CUENTA_CORRIENTE">Cuenta corriente</option>
                            </select>
                        </div>

                        <div class="relative flex items-start pt-2">
                            <div class="flex h-6 items-center">
                                <input asp-for="IgnorarLimiteCredito" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                            </div>
                            <div class="ml-3 text-sm leading-6">
                                <label asp-for="IgnorarLimiteCredito" class="font-medium text-gray-900">Ignorar límite de crédito (Admin)</label>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Errores de validacion -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="px-4 pb-4">
                        <div class="rounded-md bg-red-50 p-4 border border-red-200">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" /></svg>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-medium text-red-800">Se encontraron errores:</h3>
                                    <div class="mt-2 text-sm text-red-700">
                                        @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5 space-y-1" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="px-4 py-4 sm:px-6 bg-gray-50 border-t border-gray-200 text-center">
                    <button type="submit" class="w-full inline-flex justify-center items-center gap-x-2 rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors">
                        <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.661 2.237a.531.531 0 01.678 0 11.947 11.947 0 007.078 2.75v2.479c0 6.136-3.667 11.73-9.413 14.566a.544.544 0 01-.508 0C1.728 19.196-1.94 13.602-1.94 7.466V4.987a11.946 11.946 0 007.078-2.75zM9.5 7.5a.75.75 0 01.75.75v1.5h1.5a.75.75 0 010 1.5h-1.5v1.5a.75.75 0 01-1.5 0v-1.5h-1.5a.75.75 0 010-1.5h1.5v-1.5a.75.75 0 01.75-.75z" clip-rule="evenodd" /></svg>
                        Confirmar venta
                    </button>
                </div>

            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const STORAGE_KEY = 'ventaCarrito';
        let carritoIndex = 0;

        document.addEventListener('DOMContentLoaded', () => {
            const carrito = obtenerCarrito();
            const tbodyCarrito = document.getElementById('carritoBody');
            if (tbodyCarrito) {
                carritoIndex = tbodyCarrito.children.length;
            }
            const carritoTieneFilas = tbodyCarrito && tbodyCarrito.children.length > 0;

            if (!carritoTieneFilas) {
                carrito.forEach(item => agregarFilaCarrito(item));
            }

            if (tbodyCarrito) {
                tbodyCarrito.addEventListener('change', (ev) => {
                    const target = ev.target;
                    if (target.matches('input[name$=".Cantidad"]')) {
                        sincronizarCantidad(target);
                    } else if (target.matches('input[type="checkbox"][name$=".PermitirVentaSinStock"]')) {
                        sincronizarPermitirSinStock(target);
                    }
                });
            }

            const inputBusqueda = document.getElementById('buscadorProductos');
            const tbodyProductos = document.getElementById('productosBody');
            const paginacion = document.getElementById('paginacionProductos');
            const urlBuscarProductos = '@Url.Action("BuscarProductos", "Venta")';
            let buscadorTimeoutId = null;

            if (inputBusqueda && tbodyProductos && urlBuscarProductos) {
                inputBusqueda.addEventListener('input', () => {
                    const termino = (inputBusqueda.value || '').trim();

                    if (buscadorTimeoutId) {
                        clearTimeout(buscadorTimeoutId);
                    }

                    buscadorTimeoutId = setTimeout(() => {
                        if (termino.length === 0) {
                            if (paginacion) {
                                paginacion.style.display = '';
                            }
                            return;
                        }

                        if (paginacion) {
                            paginacion.style.display = 'none';
                        }

                        fetch(urlBuscarProductos + '?q=' + encodeURIComponent(termino))
                            .then(r => r.ok ? r.json() : [])
                            .then(data => {
                                if (!Array.isArray(data)) return;
                                tbodyProductos.innerHTML = '';

                                data.forEach(p => {
                                    const tr = document.createElement('tr');
                                    const sku = p.sku || '';
                                    const nombre = p.nombre || '';
                                    const precio = typeof p.precio === 'number' ? p.precio : 0;
                                    const stock = typeof p.stock === 'number' ? p.stock : 0;
                                    const stockMinimo = typeof p.stockMinimo === 'number' ? p.stockMinimo : 0;
                                    const esCritico = p.stockCritico === true || (stockMinimo > 0 && stock <= stockMinimo);

                                    tr.className = (esCritico ? 'bg-red-50 hover:bg-red-100' : 'hover:bg-gray-50') + ' transition-colors';
                                    tr.innerHTML = `
                                        <td class="whitespace-nowrap py-3 pl-4 pr-3 font-medium text-gray-900 sm:pl-3">${sku}</td>
                                        <td class="px-3 py-3 text-gray-900 truncate max-w-xs" title="${nombre}">${nombre}</td>
                                        <td class="whitespace-nowrap px-3 py-3 text-gray-500 font-medium">$ ${precio.toFixed(2)}</td>
                                        <td class="whitespace-nowrap px-3 py-3 text-gray-500">
                                            ${stock}
                                            ${esCritico ? '<span class="ml-2 inline-flex items-center rounded-md bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Crítico</span>' : ''}
                                        </td>
                                        <td class="relative whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-3">
                                            <button type="button"
                                                    class="inline-flex items-center rounded bg-indigo-50 px-2 py-1 text-xs font-semibold text-indigo-600 shadow-sm hover:bg-indigo-100 transition-colors"
                                                    data-id="${p.id}"
                                                    data-sku="${sku}"
                                                    data-nombre="${nombre}"
                                                    data-precio="${precio}"
                                                    data-stock="${stock}"
                                                    data-critico="${esCritico}"
                                                    onclick="agregarAlCarritoDesdeBoton(this)">
                                                Agregar
                                            </button>
                                        </td>`;
                                    tbodyProductos.appendChild(tr);
                                });
                            })
                            .catch(() => { /* ignorar errores de red en busqueda rapida */ });
                    }, 300);
                });
            }

            recalcularTotalCarrito();
        });

        function obtenerCarrito() {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return [];
            try {
                const arr = JSON.parse(raw);
                if (!Array.isArray(arr)) return [];
                return arr;
            } catch {
                return [];
            }
        }

        function guardarCarrito(carrito) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(carrito));
        }

        function agregarAlCarritoDesdeBoton(btn) {
            const id = parseInt(btn.getAttribute('data-id') || '0', 10);
            if (!id) return;
            const sku = btn.getAttribute('data-sku') || '';
            const nombre = btn.getAttribute('data-nombre') || '';
            const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);
            const precio = parseFloat(btn.getAttribute('data-precio') || '0') || 0;

            const carrito = obtenerCarrito();
            const existente = carrito.find(x => x.productoId === id);
            if (existente) {
                existente.cantidad = (existente.cantidad || 0) + 1;
                if (isNaN(existente.precioUnitario)) {
                    existente.precioUnitario = precio;
                }
                guardarCarrito(carrito);
                
                const row = document.querySelector(`#carritoBody tr[data-producto-id="${id}"]`);
                if (row) {
                    const inputCant = row.querySelector('input[name$=".Cantidad"]');
                    const inputPrecio = row.querySelector('input[name$=".PrecioUnitario"]');
                    if (inputCant) inputCant.value = existente.cantidad;
                    if (inputPrecio && !isNaN(precio)) inputPrecio.value = precio;
                }
            } else {
                const item = {
                    productoId: id,
                    sku: sku,
                    nombre: nombre,
                    stock: isNaN(stock) ? 0 : stock,
                    cantidad: 1,
                    permitirSinStock: false,
                    precioUnitario: precio
                };
                carrito.push(item);
                guardarCarrito(carrito);
                agregarFilaCarrito(item);
            }

            recalcularTotalCarrito();
        }

        function agregarFilaCarrito(item) {
            const tbody = document.getElementById('carritoBody');
            const index = carritoIndex++;
            const precioUnitario = isNaN(item.precioUnitario) ? 0 : Number(item.precioUnitario);

            const tr = document.createElement('tr');
            tr.setAttribute('data-producto-id', item.productoId);
            tr.setAttribute('data-precio-unitario', precioUnitario.toString());
            tr.className = "hover:bg-gray-50";

            // Col 1: Prod & Precio
            const tdProd = document.createElement('td');
            tdProd.className = "py-3 pl-4 pr-3 text-sm";
            const hiddenId = document.createElement('input');
            hiddenId.type = 'hidden';
            hiddenId.name = `Lineas[${index}].ProductoId`;
            hiddenId.value = item.productoId;
            tdProd.appendChild(hiddenId);
            
            const divName = document.createElement('div');
            divName.className = "font-medium text-gray-900 truncate max-w-[12rem]";
            divName.title = (item.sku ? item.sku + ' - ' : '') + item.nombre;
            divName.textContent = divName.title;
            tdProd.appendChild(divName);

            const divPrecio = document.createElement('div');
            divPrecio.className = "text-gray-500 text-xs mt-1";
            const hiddenPrecio = document.createElement('input');
            hiddenPrecio.type = 'hidden';
            hiddenPrecio.name = `Lineas[${index}].PrecioUnitario`;
            hiddenPrecio.value = precioUnitario;
            hiddenPrecio.className = 'precio-unitario';
            divPrecio.appendChild(hiddenPrecio);
            divPrecio.appendChild(document.createTextNode(`$ ${precioUnitario.toFixed(2)} (Disp: ${item.stock ?? 0})`));
            tdProd.appendChild(divPrecio);

            tr.appendChild(tdProd);

            // Col 2: Cant / Perm
            const tdCant = document.createElement('td');
            tdCant.className = "px-2 py-3 text-sm align-top";
            
            const divCont = document.createElement('div');
            divCont.className = "flex flex-col items-center gap-2";
            
            const inputCant = document.createElement('input');
            inputCant.type = 'number';
            inputCant.className = 'block w-20 rounded-md border-0 py-1 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm cantidad-input text-center';
            inputCant.name = `Lineas[${index}].Cantidad`;
            inputCant.value = (item.cantidad && item.cantidad > 0) ? item.cantidad : 1;
            inputCant.min = '1';
            inputCant.step = '1';
            divCont.appendChild(inputCant);

            const divPerm = document.createElement('div');
            divPerm.className = "flex items-center";
            divPerm.title = "Permitir venta sin stock";
            const chk = document.createElement('input');
            chk.type = 'checkbox';
            chk.className = 'h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600';
            chk.name = `Lineas[${index}].PermitirVentaSinStock`;
            chk.value = 'true';
            chk.checked = !!item.permitirSinStock;
            chk.addEventListener('change', () => {
                const carrito = obtenerCarrito();
                const existente = carrito.find(x => x.productoId === item.productoId);
                if (existente) {
                    existente.permitirSinStock = chk.checked;
                    guardarCarrito(carrito);
                }
            });
            divPerm.appendChild(chk);
            const lblPerm = document.createElement('label');
            lblPerm.className = "ml-1 text-[10px] text-gray-500";
            lblPerm.textContent = "Sin stock";
            divPerm.appendChild(lblPerm);

            divCont.appendChild(divPerm);
            tdCant.appendChild(divCont);
            tr.appendChild(tdCant);

            // Col 3: Quitar
            const tdQuitar = document.createElement('td');
            tdQuitar.className = "whitespace-nowrap py-3 pl-3 pr-4 text-right text-sm font-medium align-middle";
            const btnQuitar = document.createElement('button');
            btnQuitar.type = 'button';
            btnQuitar.className = 'text-red-600 hover:text-red-900';
            btnQuitar.innerHTML = `<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg>`;
            btnQuitar.addEventListener('click', () => quitarProductoDelCarrito(item.productoId, tr));
            tdQuitar.appendChild(btnQuitar);
            tr.appendChild(tdQuitar);

            tbody.appendChild(tr);
            recalcularTotalCarrito();
        }

        function quitarProductoDelCarrito(productoId, row) {
            const carrito = obtenerCarrito().filter(x => x.productoId !== productoId);
            guardarCarrito(carrito);
            row.remove();
            recalcularTotalCarrito();
        }

        function limpiarCarrito() {
            if (!confirm('¿Estás seguro de que quieres limpiar todo el carrito?')) {
                return;
            }
            const tbody = document.getElementById('carritoBody');
            tbody.innerHTML = '';
            carritoIndex = 0;
            localStorage.removeItem(STORAGE_KEY);
            recalcularTotalCarrito();
        }

        function sincronizarCantidad(input) {
            let val = parseInt(input.value || '0', 10);
            if (isNaN(val) || val < 1) {
                val = 1;
                input.value = '1';
            }
            const fila = input.closest('tr');
            const productoId = fila ? parseInt(fila.getAttribute('data-producto-id') || '0', 10) : 0;
            if (productoId) {
                const carrito = obtenerCarrito();
                const existente = carrito.find(x => x.productoId === productoId);
                if (existente) {
                    existente.cantidad = val;
                    guardarCarrito(carrito);
                }
            }
            recalcularTotalCarrito();
        }

        function sincronizarPermitirSinStock(input) {
            const fila = input.closest('tr');
            const productoId = fila ? parseInt(fila.getAttribute('data-producto-id') || '0', 10) : 0;
            if (!productoId) return;
            const carrito = obtenerCarrito();
            const existente = carrito.find(x => x.productoId === productoId);
            if (existente) {
                existente.permitirSinStock = input.checked;
                guardarCarrito(carrito);
            }
        }

        function recalcularTotalCarrito() {
            const tbody = document.getElementById('carritoBody');
            let total = 0;
            if (tbody) {
                tbody.querySelectorAll('tr').forEach(row => {
                    const cantInput = row.querySelector('input[name$=".Cantidad"]');
                    const precioInput = row.querySelector('input[name$=".PrecioUnitario"]');
                    const cantidad = parseFloat(cantInput && cantInput.value ? cantInput.value : '0');
                    const precio = parseFloat(precioInput && precioInput.value ? precioInput.value : row.getAttribute('data-precio-unitario') || '0');
                    if (!isNaN(cantidad) && !isNaN(precio)) {
                        total += cantidad * precio;
                    }
                });
            }
            const totalLabel = document.getElementById('totalCarritoMonto');
            if (totalLabel) {
                totalLabel.textContent = '$ ' + total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        }
    </script>
    <script>
        (function () {
            const tipoClienteSelect = document.getElementById('TipoCliente');
            const grupoClienteRegistrado = document.getElementById('grupoClienteRegistrado');
            const tipoPagoSelect = document.getElementById('TipoPago');
            const clienteSelect = document.getElementById('ClienteId');

            function actualizarUIClientePago() {
                const tipo = tipoClienteSelect ? tipoClienteSelect.value : 'CONSUMIDOR_FINAL';

                if (tipo === 'CONSUMIDOR_FINAL') {
                    if (grupoClienteRegistrado) {
                        grupoClienteRegistrado.style.display = 'none';
                        grupoClienteRegistrado.classList.add('hidden');
                    }
                    if (clienteSelect) {
                        clienteSelect.value = '';
                    }
                    if (tipoPagoSelect) {
                        tipoPagoSelect.value = 'CONTADO';
                        tipoPagoSelect.disabled = true;
                    }
                } else if (tipo === 'REGISTRADO') {
                    if (grupoClienteRegistrado) {
                        grupoClienteRegistrado.style.display = '';
                        grupoClienteRegistrado.classList.remove('hidden');
                    }
                    if (tipoPagoSelect) {
                        tipoPagoSelect.disabled = false;
                    }
                }
            }

            if (tipoClienteSelect) {
                tipoClienteSelect.addEventListener('change', actualizarUIClientePago);
                actualizarUIClientePago();
            }
        })();
    </script>
}
