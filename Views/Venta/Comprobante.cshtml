@model mi_ferreteria.ViewModels.VentaComprobanteViewModel

@{
    Layout = "_Layout";
    var venta = Model.Venta;
    var factura = Model.Factura;
}

<div class="max-w-4xl mx-auto mt-6 bg-white shadow sm:rounded-lg overflow-hidden border border-gray-200">
    
    @if (!string.Equals(venta.Estado, "CONFIRMADA", System.StringComparison.OrdinalIgnoreCase))
    {
        <div class="bg-yellow-50 border-b border-yellow-200 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-yellow-800">Atención</h3>
                    <div class="mt-2 text-sm text-yellow-700">
                        <p>Esta venta se encuentra con estado <strong class="font-bold">@venta.Estado</strong>. El comprobante puede no ser válido hasta que se confirme.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="px-4 py-6 sm:px-6 border-b border-gray-200">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-6">
            <div>
                <h3 class="text-xl font-bold leading-7 text-gray-900 mb-2">Comprobante de Pago</h3>
                <p class="text-sm text-gray-500 mb-1"><span class="font-medium text-gray-900">Fecha:</span> @venta.Fecha.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="text-sm text-gray-500 mb-1"><span class="font-medium text-gray-900">Venta N°:</span> @venta.Id</p>
                @if (factura != null)
                {
                    var tipoFactura = venta.TipoPago == "CUENTA_CORRIENTE" ? "Cuenta corriente" : "Contado";
                    <p class="text-sm text-gray-500 mt-2">
                        <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 mb-1">@factura.TipoComprobante</span><br/>
                        <span class="font-medium text-gray-900">N° @factura.PuntoVenta.ToString("0000")-@factura.Numero.ToString("00000000")</span> (@tipoFactura)
                    </p>
                }
            </div>
            <div class="sm:text-right bg-gray-50 rounded-md p-4 border border-gray-100 min-w-[250px]">
                <p class="text-sm text-gray-700 mb-1"><strong class="font-semibold text-gray-900">Cliente:</strong> @(factura?.ClienteNombre ?? "CONSUMIDOR FINAL")</p>
                @if (!string.IsNullOrWhiteSpace(factura?.ClienteDocumento))
                {
                    <p class="text-sm text-gray-700 mb-1"><strong class="font-semibold text-gray-900">Documento:</strong> @factura.ClienteDocumento</p>
                }
                @if (!string.IsNullOrWhiteSpace(factura?.ClienteDireccion))
                {
                    <p class="text-sm text-gray-700 mb-1"><strong class="font-semibold text-gray-900">Dirección:</strong> @factura.ClienteDireccion</p>
                }
                <div class="mt-2 pt-2 border-t border-gray-200">
                    <p class="text-sm text-gray-700"><strong class="font-semibold text-gray-900">Forma de pago:</strong> @(venta.TipoPago == "CUENTA_CORRIENTE" ? "Cuenta corriente" : "Contado")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="p-4 sm:p-6">
        <h4 class="text-base font-semibold leading-6 text-gray-900 mb-4">Detalle de productos</h4>
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Producto</th>
                        <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Cantidad</th>
                        <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">P. Unitario</th>
                        <th scope="col" class="py-3.5 pl-3 pr-4 text-right text-sm font-semibold text-gray-900 sm:pr-6">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">@d.Descripcion</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 text-right">@d.Cantidad</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 text-right">@d.PrecioUnitario.ToString("C")</td>
                            <td class="whitespace-nowrap py-4 pl-3 pr-4 text-sm text-gray-900 font-medium text-right sm:pr-6">@d.Subtotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-gray-50 border-t border-gray-200">
                    <tr>
                        <th scope="row" colspan="3" class="hidden pl-6 pr-3 pt-4 text-right text-sm font-semibold text-gray-900 sm:table-cell sm:pl-0">TOTAL</th>
                        <th scope="row" class="pl-4 pr-3 pt-4 text-left text-sm font-semibold text-gray-900 sm:hidden">TOTAL</th>
                        <td class="pl-3 pr-4 pt-4 text-right text-lg font-bold text-gray-900 sm:pr-6">@venta.Total.ToString("C")</td>
                    </tr>
                    <tr>
                        <th scope="row" colspan="3" class="hidden pl-6 pr-3 pb-4 text-right text-sm font-normal text-gray-500 sm:table-cell sm:pl-0 pt-2">Total en letras</th>
                        <th scope="row" class="pl-4 pr-3 pb-4 text-left text-sm font-normal text-gray-500 sm:hidden pt-2">Total en letras</th>
                        <td class="pl-3 pr-4 pb-4 text-right text-sm text-gray-500 italic sm:pr-6 pt-2">@venta.TotalEnLetras</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="mt-8 flex justify-end gap-3 print:hidden">
            <a asp-action="Index" class="btn-secondary">Volver</a>
            <button onclick="window.print()" class="btn-primary gap-x-1.5">
                <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0118 8.653v4.647c0 1.02-.756 1.884-1.748 2.064-.236.04-.474.078-.714.114V17.5c0 .966-.784 1.75-1.75 1.75h-6.5A1.75 1.75 0 015 17.5v-2.022c-.24-.036-.478-.074-.714-.114A2.21 2.21 0 012 13.3v-4.647c0-1.02.756-1.884 1.748-2.064A4.148 4.148 0 015 6.302V2.75zm1.75-.25a.25.25 0 00-.25.25v3.5h7V2.75a.25.25 0 00-.25-.25h-6.5zm-2.25 12.374V17.5c0 .138.112.25.25.25h6.5a.25.25 0 00.25-.25v-2.626a.25.25 0 00-.25-.25h-6.5a.25.25 0 00-.25.25zm10.748-8.86a2.648 2.648 0 00-3.373 0 .75.75 0 01-1.107 0 2.648 2.648 0 00-3.373 0 .75.75 0 01-1.107 0 2.648 2.648 0 00-3.373 0 1.5 1.5 0 00.916 2.502h9.423a1.5 1.5 0 00.916-2.502z" clip-rule="evenodd" />
                </svg>
                Imprimir / Guardar PDF
            </button>
        </div>
    </div>
</div>

<style>
    @@media print {
        body {
            background-color: white !important;
        }
        main {
            padding: 0 !important;
            margin: 0 !important;
        }
        .max-w-4xl {
            max-width: 100% !important;
            margin: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }
        /* Ocultar barra de navegacion lateral si existe */
        aside, nav, header {
            display: none !important;
        }
        .print\:hidden {
            display: none !important;
        }
    }
</style>

@section Scripts {
    <script>
        // Al mostrar el comprobante, limpiar el carrito guardado en el navegador
        (function () {
            try {
                const STORAGE_KEY = 'ventaCarrito';
                localStorage.removeItem(STORAGE_KEY);
            } catch (e) {
                console.error('No se pudo limpiar el carrito:', e);
            }
        })();
    </script>
}
