@model mi_ferreteria.ViewModels.ClienteCreateViewModel
@{
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Crear cliente";
    }
}

@if (!isAjax)
{
<div class="md:flex md:items-center md:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Crear cliente
        </h2>
    </div>
</div>
}
else
{
<div class="px-6 pt-6 pb-2">
    <h2 class="text-xl font-bold text-gray-900">Crear cliente</h2>
</div>
}

<form asp-action="Create" method="post" class="space-y-8 bg-white p-6 sm:p-8 shadow-sm rounded-lg border border-gray-200">
    <div class="space-y-8 divide-y divide-gray-200">
        <div>
            <div>
                <h3 class="text-base font-semibold leading-6 text-gray-900">Información Personal / Comercial</h3>
                <p class="mt-1 text-sm text-gray-500">Datos principales para identificar al cliente temporal o empresarial.</p>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    <label asp-for="Nombre" class="block text-sm font-medium leading-6 text-gray-900">Nombre / Razón social</label>
                    <div class="mt-2">
                        <input asp-for="Nombre" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Nombre" class="mt-2 text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Apellido" class="block text-sm font-medium leading-6 text-gray-900">Apellido</label>
                    <div class="mt-2">
                        <input asp-for="Apellido" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Apellido" class="mt-2 text-sm text-red-600"></span>
                        <p class="mt-1 text-xs text-gray-500">Se completa solo para DNI; si elegís CUIT se limpia automáticamente.</p>
                    </div>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="TipoDocumento" class="block text-sm font-medium leading-6 text-gray-900">Tipo de Documento</label>
                    <div class="mt-2">
                        <select asp-for="TipoDocumento" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="DNI">DNI</option>
                            <option value="CUIT">CUIT</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="mt-2 text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="NumeroDocumento" class="block text-sm font-medium leading-6 text-gray-900">Número de DNI / CUIT</label>
                    <div class="mt-2">
                        <input asp-for="NumeroDocumento" inputmode="numeric" pattern="[0-9]+" placeholder="Ej: 12345678 / 20123456789" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="NumeroDocumento" class="mt-2 text-sm text-red-600"></span>
                        <p class="mt-1 text-xs text-gray-500">Ingresá solo números (DNI sin puntos, CUIT sin guiones).</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-8">
            <div>
                <h3 class="text-base font-semibold leading-6 text-gray-900">Contacto y Ubicación</h3>
                <p class="mt-1 text-sm text-gray-500">¿Cómo contactamos al cliente y dónde se encuentra?</p>
            </div>
            <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    <label asp-for="Telefono" class="block text-sm font-medium leading-6 text-gray-900">Teléfono</label>
                    <div class="mt-2">
                        <input asp-for="Telefono" type="tel" inputmode="tel" pattern="[+0-9 ()-]{7,20}" placeholder="Ej: +54 381 6612233" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Telefono" class="mt-2 text-sm text-red-600"></span>
                        <p class="mt-1 text-xs text-gray-500">Permitidos números, espacios y los símbolos + ( ) - (7 a 20 caracteres).</p>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Email" class="block text-sm font-medium leading-6 text-gray-900">Email</label>
                    <div class="mt-2">
                        <input asp-for="Email" type="email" placeholder="Ej: cliente@gmail.com" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Email" class="mt-2 text-sm text-red-600"></span>
                    </div>
                </div>
                
                <div class="sm:col-span-4">
                    <label asp-for="DireccionCalleNumero" class="block text-sm font-medium leading-6 text-gray-900">Calle y número</label>
                    <div class="mt-2">
                        <input asp-for="DireccionCalleNumero" placeholder="Ej: Lamadrid 123" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="DireccionCalleNumero" class="mt-2 text-sm text-red-600"></span>
                        <p class="mt-1 text-xs text-gray-500">Obligatoria si el cliente tiene CUIT o cuenta corriente.</p>
                    </div>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="DireccionPisoDpto" class="block text-sm font-medium leading-6 text-gray-900">Piso / Dpto</label>
                    <div class="mt-2">
                        <input asp-for="DireccionPisoDpto" placeholder="Ej: 4° B" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="DireccionPisoDpto" class="mt-2 text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="DireccionLocalidad" class="block text-sm font-medium leading-6 text-gray-900">Localidad</label>
                    <div class="mt-2">
                        <input asp-for="DireccionLocalidad" placeholder="Ej: San Miguel de Tucumán" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="DireccionLocalidad" class="mt-2 text-sm text-red-600"></span>
                        <p class="mt-1 text-xs text-gray-500">Obligatoria si el cliente tiene CUIT o cuenta corriente.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-8">
            <div>
                <h3 class="text-base font-semibold leading-6 text-gray-900">Condiciones Comerciales</h3>
                <p class="mt-1 text-sm text-gray-500">Configuración de crédito y tipo de cliente.</p>
            </div>
            
            <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6 items-end">
                <div class="sm:col-span-2">
                    <label asp-for="TipoCliente" class="block text-sm font-medium leading-6 text-gray-900">Tipo de cliente</label>
                    <div class="mt-2">
                        <select asp-for="TipoCliente" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="CONSUMIDOR_FINAL">Consumidor final</option>
                            <option value="CUENTA_CORRIENTE">Cuenta corriente</option>
                        </select>
                        <span asp-validation-for="TipoCliente" class="mt-2 text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <div class="flex items-center justify-between gap-4">
                        <span class="flex flex-col flex-1">
                            <span class="text-sm font-medium leading-6 text-gray-900" id="cliente-activo-label">Estado del cliente</span>
                            <span class="text-sm text-gray-500" id="cliente-activo-description">Define si al cliente se le pueden cargar ventas.</span>
                        </span>
                        <label class="relative inline-flex items-center gap-3">
                            <span class="text-xs font-semibold text-gray-500">Inactivo</span>
                            <div class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" asp-for="Activo" class="sr-only peer" aria-labelledby="cliente-activo-label" aria-describedby="cliente-activo-description">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-indigo-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                            </div>
                            <span class="text-xs font-semibold text-gray-900">Activo</span>
                        </label>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="LimiteCredito" class="block text-sm font-medium leading-6 text-gray-900">Límite de crédito asignado</label>
                    <div class="relative mt-2 rounded-md shadow-sm">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <span class="text-gray-500 sm:text-sm">$</span>
                        </div>
                        <input asp-for="LimiteCredito" type="number" step="0.01" min="0" class="block w-full rounded-md border-0 py-1.5 pl-7 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="LimiteCredito" class="mt-2 text-sm text-red-600"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="SaldoInicialCuentaCorriente" class="block text-sm font-medium leading-6 text-gray-900">Saldo inicial a registrar</label>
                    <div class="relative mt-2 rounded-md shadow-sm">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <span class="text-gray-500 sm:text-sm">$</span>
                        </div>
                        <input asp-for="SaldoInicialCuentaCorriente" type="number" step="0.01" class="block w-full rounded-md border-0 py-1.5 pl-7 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="SaldoInicialCuentaCorriente" class="mt-2 text-sm text-red-600"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="pt-5 mt-6 border-t border-gray-200">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-gray-500 text-xs text-center sm:text-left">Si vuelve atrás o cancela, se perderán los datos no guardados.</p>
            <div class="flex justify-end gap-x-3 w-full sm:w-auto">
                @if (isAjax)
                {
                    <button type="button" onclick="closeAjaxModal()" class="btn-secondary w-full sm:w-auto">Cancelar</button>
                }
                else
                {
                    <a asp-action="Index" class="btn-secondary w-full sm:w-auto">Cancelar</a>
                }
                <button type="submit" class="btn-primary w-full sm:w-auto">Guardar</button>
            </div>
        </div>
    </div>
</form>

@if (!isAjax)
{
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            let isDirty = false;
            const form = document.querySelector('form');
            if (!form) return;
            form.addEventListener('change', function () { isDirty = true; });
            form.addEventListener('submit', function () { isDirty = false; });
            window.addEventListener('beforeunload', function (e) {
                if (!isDirty) return;
                e.preventDefault();
                e.returnValue = 'Tiene cambios sin guardar. Si vuelve atrás, se perderán.';
            });
        })();
        (function () {
            const tipoSelect = document.querySelector('select[name="TipoDocumento"]');
            const apellidoInput = document.querySelector('input[name="Apellido"]');
            const validationSpan = document.querySelector('[data-valmsg-for="Apellido"]');
            if (!tipoSelect || !apellidoInput) return;

            const toggleApellido = () => {
                const isCuit = (tipoSelect.value || '').toUpperCase() === 'CUIT';
                apellidoInput.disabled = isCuit;
                if (isCuit) {
                    if (apellidoInput.value) {
                        apellidoInput.value = '';
                        apellidoInput.dispatchEvent(new Event('input'));
                    }
                    if (validationSpan) {
                        validationSpan.textContent = '';
                    }
                }
            };

            tipoSelect.addEventListener('change', toggleApellido);
            toggleApellido();
        })();
    </script>
}
}
else
{
    <script>
        (function () {
            let isDirty = false;
            const form = document.querySelector('#ajaxModal form') || document.querySelector('form');
            if (!form) return;
            form.addEventListener('change', function () { isDirty = true; });
            form.addEventListener('submit', function () { isDirty = false; });
        })();
        (function () {
            const container = document.querySelector('#ajaxModal form') || document;
            const tipoSelect = container.querySelector('select[name="TipoDocumento"]');
            const apellidoInput = container.querySelector('input[name="Apellido"]');
            const validationSpan = container.querySelector('[data-valmsg-for="Apellido"]');
            if (!tipoSelect || !apellidoInput) return;

            const toggleApellido = () => {
                const isCuit = (tipoSelect.value || '').toUpperCase() === 'CUIT';
                apellidoInput.disabled = isCuit;
                if (isCuit) {
                    if (apellidoInput.value) {
                        apellidoInput.value = '';
                        apellidoInput.dispatchEvent(new Event('input'));
                    }
                    if (validationSpan) {
                        validationSpan.textContent = '';
                    }
                }
            };

            tipoSelect.addEventListener('change', toggleApellido);
            toggleApellido();
        })();
    </script>
}
