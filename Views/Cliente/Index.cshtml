@model IEnumerable<mi_ferreteria.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
    string q = ViewBag.Query as string ?? string.Empty;
    int page = ViewBag.Page is int ? (int)ViewBag.Page : 1;
    int totalPages = ViewBag.TotalPages is int ? (int)ViewBag.TotalPages : 1;
    string sort = ViewBag.Sort as string ?? "nombre_asc";
    string NextSort(string col) {
        return col switch
        {
            "nombre" => sort == "nombre_asc" ? "nombre_desc" : "nombre_asc",
            "tipocliente" => sort == "tipocliente_asc" ? "tipocliente_desc" : "tipocliente_asc",
            "limite" => sort == "limite_asc" ? "limite_desc" : "limite_asc",
            "estado" => sort == "estado_asc" ? "estado_desc" : "estado_asc",
            _ => "nombre_asc"
        };
    }
    string Arrow(string col) {
        if (col == "nombre" && sort.StartsWith("nombre_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "tipocliente" && sort.StartsWith("tipocliente_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "limite" && sort.StartsWith("limite_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "estado" && sort.StartsWith("estado_")) return sort.EndsWith("asc") ? "↑" : "↓";
        return "↕";
    }
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Clientes
        </h2>
        <p class="mt-2 text-sm text-gray-700">Administre su cartera de clientes, incluyendo cuentas corrientes y consumidores finales.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
        <button type="button" onclick="openAjaxModal('@Url.Action("Create")')" class="btn-primary">
            Crear cliente
        </button>
    </div>
    </div>
</div>

<div class="mb-6 bg-white p-4 shadow-sm rounded-lg border border-gray-200">
    <form method="get" asp-action="Index" class="flex items-center gap-2">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="sort" value="@sort" />
        <div class="relative flex-1">
            <input type="search" name="q" id="search" value="@q"
                   class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-4 pr-10 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]"
                   placeholder="Buscar por nombre, documento o email" />
        </div>
        <button type="submit"
                class="group flex items-center justify-center rounded-lg bg-gray-900 p-2.5 text-white shadow-sm transition-colors duration-200 hover:bg-[#FC651F] focus:outline-none focus:ring-2 focus:ring-[#FC651F] focus:ring-offset-1"
                title="Buscar">
            <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
            </svg>
        </button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="Index" asp-route-sort="@sort" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900">
                Limpiar
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="rounded-md bg-blue-50 p-4 shadow-sm border border-blue-100">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1 md:flex md:justify-between">
                <p class="text-sm text-blue-700">No hay clientes cargados o que coincidan con la búsqueda.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="mt-4 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 table-clientes">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">ID</th>
                                <th scope="col" class="px-2 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("nombre")' asp-route-page="1" class="group inline-flex items-center gap-1 text-gray-900 hover:text-gray-600">
                                        Cliente <span class="text-gray-400 group-hover:text-gray-600">@Html.Raw(Arrow("nombre"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="px-2 py-3.5 text-left text-sm font-semibold text-gray-900">Documento</th>
                                <th scope="col" class="px-2 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("tipocliente")' asp-route-page="1" class="group inline-flex items-center gap-1 text-gray-900 hover:text-gray-600">
                                        Tipo <span class="text-gray-400 group-hover:text-gray-600">@Html.Raw(Arrow("tipocliente"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="px-2 py-3.5 text-left text-sm font-semibold text-gray-900">Contacto</th>
                                <th scope="col" class="px-2 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("limite")' asp-route-page="1" class="group inline-flex items-center gap-1 text-gray-900 hover:text-gray-600">
                                        Límite crédito <span class="text-gray-400 group-hover:text-gray-600">@Html.Raw(Arrow("limite"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="px-2 py-3.5 text-center text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("estado")' asp-route-page="1" class="group inline-flex items-center gap-1 justify-center text-gray-900 hover:text-gray-600">
                                        Estado <span class="text-gray-400 group-hover:text-gray-600">@Html.Raw(Arrow("estado"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-gray-900">
                                    <span class="sr-only">Acciones</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var c in Model)
                            {
                                <tr class="hover:bg-gray-50 cursor-pointer transition-colors" data-href="@Url.Action("Details", new { id = c.Id })">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6 w-16">@c.Id</td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-gray-900">
                                        <div class="font-medium">@c.Nombre</div>
                                        @if (!string.IsNullOrWhiteSpace(c.Apellido))
                                        {
                                            <div class="text-gray-500">@c.Apellido</div>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-gray-500">
                                        @if (!string.IsNullOrWhiteSpace(c.TipoDocumento) || !string.IsNullOrWhiteSpace(c.NumeroDocumento))
                                        {
                                            @($"{c.TipoDocumento} {c.NumeroDocumento}")
                                        }
                                        else
                                        {
                                            @("-")
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-gray-500">
                                        @if (c.TipoCliente == "CUENTA_CORRIENTE")
                                        {
                                            <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Cuenta corriente</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Consumidor final</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-gray-500">
                                        @if (!string.IsNullOrWhiteSpace(c.Telefono))
                                        {
                                            <div>📞 @c.Telefono</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.Email))
                                        {
                                            <div>✉️ @c.Email</div>
                                        }
                                        @if (string.IsNullOrWhiteSpace(c.Telefono) && string.IsNullOrWhiteSpace(c.Email))
                                        {
                                            @("-")
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-gray-900 font-medium">
                                        @(c.CuentaCorrienteHabilitada ? "$ " + c.LimiteCredito.ToString("N2") : "-")
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-4 text-sm text-center">
                                        @if (c.Activo)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Inactivo</span>
                                        }
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex items-center justify-end gap-3 z-10 relative">
                                            <a asp-action="Details" asp-route-id="@c.Id" class="tbl-link-edit">Ver</a>
                                            <button type="button" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("Edit", new { id = c.Id })');" class="tbl-link-edit">Editar</button>
                                            @if (c.Activo)
                                            {
                                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="inline m-0">
                                                    <button type="submit" class="text-red-600 hover:text-red-900 btn-baja" onclick="return confirm('¿Dar de baja este cliente?');">Baja</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" asp-route-id="@c.Id" method="post" class="inline m-0">
                                                    <button type="submit" class="tbl-link-activate">Activar</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        var start = System.Math.Max(1, page - 2);
        var end = System.Math.Min(totalPages, page + 2);
        
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-6 shadow sm:rounded-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@(page + 1)" class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Página <span class="font-medium">@(page)</span> de <span class="font-medium">@totalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@(page - 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 hover:bg-orange-50 transition-colors focus:z-20 @(page <= 1 ? "pointer-events-none opacity-40 text-gray-400" : "text-[#FC651F]")">
                            <span class="sr-only">Anterior</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        
                        @for (var i = start; i <= end; i++)
                        {
                            if (i == page)
                            {
                                <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@i" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-orange-50 hover:text-[#FC651F] transition-colors focus:z-20">@i</a>
                            }
                        }

                        <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@(page + 1)" class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 hover:bg-orange-50 transition-colors focus:z-20 @(page >= totalPages ? "pointer-events-none opacity-40 text-gray-400" : "text-[#FC651F]")">
                            <span class="sr-only">Siguiente</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <!-- Partial View Validation via Ajax Validation Unobtrusive -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = document.querySelectorAll('table.table-clientes tbody tr[data-href]');
            rows.forEach((row) => {
                row.addEventListener('click', (event) => {
                    const target = event.target;
                    // Check if clicked exactly on a button or link
                    if (target.closest('a, button, input, select, textarea, label, form')) {
                        return;
                    }
                    const href = row.getAttribute('data-href');
                    if (href) {
                        window.location.href = href;
                    }
                });
            });
            
            // Búsqueda con debounce
            const qInput = document.querySelector('form[method="get"] input[name="q"]');
            const form = qInput && qInput.closest('form');
            if (qInput && form) {
                let timer;
                qInput.addEventListener('input', function(){
                    clearTimeout(timer);
                    const pageField = form.querySelector('input[name="page"]');
                    if (pageField) pageField.value = '1';
                    timer = setTimeout(() => { form.requestSubmit(); }, 300);
                });
            }
        });

        // AJAX Modal Scripts
        function openAjaxModal(url) {
            const modal = document.getElementById('ajaxModal');
            const container = document.getElementById('ajaxModalContentContainer');
            const spinner = document.getElementById('ajaxModalSpinner');

            container.innerHTML = '';
            spinner.classList.remove('hidden');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => response.text())
                .then(html => {
                    spinner.classList.add('hidden');
                    container.innerHTML = html;
                    setupAjaxForm(container);
                })
                .catch(err => {
                    console.error('Error fetching modal content', err);
                    spinner.classList.add('hidden');
                    container.innerHTML = '<div class="p-4 text-red-600">Ocurrió un error al cargar el formulario.</div>';
                });
        }

        function closeAjaxModal() {
            const modal = document.getElementById('ajaxModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('ajaxModalContentContainer').innerHTML = '';
        }

        function setupAjaxForm(container) {
            const form = container.querySelector('form');
            if (!form) return;

            // Re-parse Unobtrusive validation
            if (window.$.validator && window.$.validator.unobtrusive) {
                window.$.validator.unobtrusive.parse(form);
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                // Validate using jQuery Unobtrusive if available
                if (window.$(form).valid && !window.$(form).valid()) {
                    return;
                }

                const formData = new FormData(form);
                const actionUrl = form.getAttribute('action');

                fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.headers.get('content-type')?.includes('application/json')) {
                        return response.json().then(data => ({ isJson: true, data }));
                    } else {
                        return response.text().then(html => ({ isJson: false, data: html }));
                    }
                })
                .then(result => {
                    if (result.isJson && result.data.success) {
                        window.location.reload();
                    } else if (!result.isJson) {
                        // Re-render form with validation errors
                        container.innerHTML = result.data;
                        setupAjaxForm(container); 
                    }
                })
                .catch(err => console.error('Form submit error:', err));
            });
            
            // Re-eval any script tags inside the container
            const scripts = container.querySelectorAll('script');
            scripts.forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                if(oldScript.parentNode) {
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                }
            });
        }
    </script>
}

<!-- AJAX Modal Container -->
<div id="ajaxModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeAjaxModal()"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0 pointer-events-none">
            <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-3xl pointer-events-auto">
                <div id="ajaxModalSpinner" class="hidden p-8 flex justify-center items-center">
                    <svg class="animate-spin -ml-1 mr-3 h-8 w-8 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-gray-600">Cargando...</span>
                </div>
                <!-- Dynamic Content Container -->
                <div id="ajaxModalContentContainer"></div>
            </div>
        </div>
    </div>
</div>
