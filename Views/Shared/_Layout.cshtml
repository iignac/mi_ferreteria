<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Ferretería</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/mi_ferreteria.styles.css" asp-append-version="true" />

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-white text-[#060304] font-sans antialiased h-screen flex overflow-hidden" x-data="{ sidebarOpen: window.innerWidth >= 768 }" @@resize.window="if(window.innerWidth < 768) sidebarOpen = false; else sidebarOpen = true;">

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <aside :class="sidebarOpen ? 'w-64' : 'w-0'" class="bg-[#060304] text-white/80 flex flex-col transition-all duration-300 ease-in-out overflow-hidden z-30 shrink-0 h-screen shadow-xl border-r border-white/10" x-cloak>
            <div class="h-16 flex items-center justify-center px-4 bg-[#060304] shrink-0 border-b border-white/10">
                <a asp-controller="Home" asp-action="Index" class="text-xl font-bold text-white flex items-center gap-2 whitespace-nowrap">
                    <svg class="h-6 w-6 text-[#FC651F]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    mi_Ferreteria
                </a>
            </div>

            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                @if (User.IsInRole("Administrador"))
                {
                    <div class="text-[0.65rem] font-bold text-white/40 uppercase tracking-wider mb-2 mt-4 px-3 whitespace-nowrap">Administración</div>
                    <a asp-controller="Admin" asp-action="Dashboard" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Dashboard</a>
                    <a asp-controller="Admin" asp-action="Finanzas" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Finanzas</a>
                    <a asp-controller="Admin" asp-action="VentasPendientes" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Ventas Pendientes</a>
                    <a asp-controller="Admin" asp-action="Auditoria" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Auditoría</a>
                    <a asp-controller="Usuario" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Usuarios y Permisos</a>
                }

                <div class="text-[0.65rem] font-bold text-white/40 uppercase tracking-wider mb-2 mt-4 px-3 whitespace-nowrap">Catálogo</div>
                <a asp-controller="Categoria" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Categorías</a>
                <a asp-controller="Producto" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Productos</a>

                <div class="text-[0.65rem] font-bold text-white/40 uppercase tracking-wider mb-2 mt-4 px-3 whitespace-nowrap">Operativa</div>
                @if (!User.IsInRole("Stock"))
                {
                    <a asp-controller="Venta" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Caja / Ventas</a>
                    <a asp-controller="Venta" asp-action="Historial" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Historial de Ventas</a>
                    <a asp-controller="Cliente" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Clientes</a>
                }
                <a asp-controller="Stock" asp-action="Index" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-[#FC651F] hover:text-white transition-colors whitespace-nowrap">Control de Stock</a>
            </nav>

            <div class="p-4 bg-[#060304] border-t border-white/10 shrink-0">
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 w-full">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-md text-sm font-semibold hover:bg-red-600 transition-colors text-white/70 hover:text-white whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                        Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>
    }

    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col h-screen min-w-0 transition-all duration-300 overflow-hidden relative">
        <!-- Top Header Navigation -->
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 sm:px-6 z-20 shrink-0 shadow-sm" style="border-bottom: 2px solid #FC651F20;">
            <div class="flex items-center gap-2 lg:gap-4">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <button @@click="sidebarOpen = !sidebarOpen" type="button" class="text-gray-500 hover:text-gray-900 focus:outline-none p-1 rounded-md hover:bg-gray-100 transition-colors">
                        <!-- Menu Icon -->
                        <svg x-show="!sidebarOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" x-cloak>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <!-- Close / Collapse Icon -->
                        <svg x-show="sidebarOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <div class="h-6 w-px bg-gray-200 mx-2 hidden sm:block"></div>
                }
                <div class="text-lg font-semibold text-gray-800">@ViewData["Title"]</div>
            </div>
            
            <div class="flex items-center gap-4">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-3 text-sm font-medium text-gray-700">
                        <span class="hidden sm:inline-block max-w-[150px] truncate">@User.Identity.Name</span>
                        @if (User.IsInRole("Administrador"))
                        {
                            <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold text-white ring-1 ring-inset" style="background-color:#FC651F; ring-color:#FC651F;">Admin</span>
                        }
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="text-sm font-medium hover:opacity-80 transition-opacity" style="color:#FC651F;">Iniciar Sesión</a>
                }
            </div>
        </header>

        <!-- Main Content Area Scrollable -->
        <main class="flex-1 overflow-y-auto bg-gray-50/50 p-4 sm:p-6 lg:p-8 relative">
            <div class="max-w-7xl mx-auto min-h-full flex flex-col">
                <!-- Alertas Globales -->
                @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
                {
                    <div x-data="{ show: true }" x-show="show" class="rounded-lg bg-green-50 p-4 mb-6 shadow-sm border border-green-200 transition-all" role="alert" x-transition>
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3 flex-1">
                                <p class="text-sm font-medium text-green-800">@ok</p>
                            </div>
                            <div class="ml-auto pl-3">
                                <button type="button" @@click="show = false" class="inline-flex rounded-md p-1.5 text-green-500 hover:bg-green-100 focus:outline-none">
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Vista Específica -->
                <div class="flex-grow">
                    @RenderBody()
                </div>

                <footer class="mt-8 py-4 border-t border-gray-200 text-center text-sm text-gray-400">
                    &copy; @DateTime.Now.Year - mi_Ferreteria
                </footer>
            </div>
        </main>
    </div>

    <!-- Scripts Bootstrap / jQuery (legacy) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
