@model AdminDashboardViewModel
@using System.Linq
@{
    ViewData["Title"] = "Panel de Administración";
    string FechaCorta(DateTimeOffset fecha) => fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}

<style>
    .stat-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.85rem 1.35rem rgba(252, 101, 31, 0.2);
        background-color: #fff8f5;
    }
    .stat-card:active {
        transform: translateY(-1px) scale(0.99);
    }
</style>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Panel de Administración
        </h2>
        <p class="mt-1 text-sm text-gray-500">Visión general de actividad y seguridad del sistema.</p>
    </div>
    <span class="mt-3 sm:mt-0 inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold text-white" style="background-color:#FC651F;">
        Solo administradores
    </span>
</div>

@* Tarjetas de resumen *@
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <a asp-controller="Venta" asp-action="Historial"
       class="stat-card bg-white rounded-xl border border-gray-200 shadow-sm p-5 group">
        <p class="text-sm text-gray-500 group-hover:text-gray-700">Ventas registradas</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">@Model.TotalVentas</p>
        <p class="text-xs mt-1" style="color:#FC651F;">Ir al historial →</p>
    </a>
    <a asp-controller="Stock" asp-action="Index"
       class="stat-card bg-white rounded-xl border border-gray-200 shadow-sm p-5 group">
        <p class="text-sm text-gray-500 group-hover:text-gray-700">Movimientos de stock</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">@Model.TotalMovimientosStock</p>
        <p class="text-xs text-gray-400 mt-1">Ingresos: @Model.TotalMovimientosIngreso &nbsp;|&nbsp; Egresos: @Model.TotalMovimientosEgreso</p>
    </a>
    <div class="stat-card bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Ventas del día</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">
            @Model.UltimasVentas.Where(v => v.Fecha.Date == DateTimeOffset.UtcNow.Date).Sum(v => v.Total).ToString("C")
        </p>
        <p class="text-xs text-gray-400 mt-1">Total acumulado hoy</p>
    </div>
    <a asp-controller="Stock" asp-action="Criticos"
       class="stat-card bg-white rounded-xl border border-gray-200 shadow-sm p-5 group">
        <p class="text-sm text-gray-500 group-hover:text-gray-700">Stock crítico</p>
        <p class="text-2xl font-bold mt-1 @(Model.ProductosStockCritico > 0 ? "text-red-600" : "text-gray-900")">
            @Model.ProductosStockCritico
        </p>
        <p class="text-xs mt-1 @(Model.ProductosStockCritico > 0 ? "text-red-500" : "text-gray-400")">
            @(Model.ProductosStockCritico > 0 ? "Ver listado urgente →" : "Sin alertas críticas")
        </p>
    </a>
</div>

@* Alertas de seguridad *@
@if (Model.AlertasSeguridad != null && Model.AlertasSeguridad.Count > 0)
{
    <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 mb-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-semibold text-amber-800 mb-1">Alertas de seguridad y control</h3>
                <ul class="text-sm text-amber-700 list-disc list-inside space-y-0.5">
                    @foreach (var alerta in Model.AlertasSeguridad)
                    {
                        <li>@alerta</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* Tablas principales *@
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-6">

    @* Ventas recientes *@
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900">Ventas recientes</h3>
            <a asp-controller="Venta" asp-action="Historial"
               class="text-xs font-medium transition-colors" style="color:#FC651F;"
               onmouseover="this.style.color='#e0541a'" onmouseout="this.style.color='#FC651F'">
                Ver historial →
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Fecha</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Pago</th>
                        <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                        <th class="px-3 py-3 pr-5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @if (Model.UltimasVentas.Any())
                    {
                        foreach (var v in Model.UltimasVentas)
                        {
                            var url = Url.Action("Comprobante", "Venta", new { id = v.Id });
                            string estadoClase = v.Estado switch {
                                "CONFIRMADA"            => "bg-green-50 text-green-700 ring-green-600/20",
                                "PENDIENTE_AUTORIZACION"=> "bg-yellow-50 text-yellow-800 ring-yellow-600/20",
                                "RECHAZADA"             => "bg-red-50 text-red-700 ring-red-600/10",
                                "ANULADA"               => "bg-gray-100 text-gray-600 ring-gray-500/10",
                                _                       => "bg-gray-100 text-gray-600 ring-gray-500/10"
                            };
                            string estadoTexto = v.Estado switch {
                                "CONFIRMADA"            => "Confirmada",
                                "PENDIENTE_AUTORIZACION"=> "Pendiente",
                                "RECHAZADA"             => "Rechazada",
                                "ANULADA"               => "Anulada",
                                _                       => v.Estado
                            };
                            <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='@url'">
                                <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm font-medium text-gray-900">#@v.Id</td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">@FechaCorta(v.Fecha)</td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">
                                    @(v.TipoPago == "CUENTA_CORRIENTE" ? "Cta. corriente" : "Contado")
                                </td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900 font-medium text-right">@v.Total.ToString("C")</td>
                                <td class="whitespace-nowrap px-3 py-3 pr-5">
                                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @estadoClase">@estadoTexto</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="py-8 text-center text-sm text-gray-400">Sin ventas registradas</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Movimientos de stock *@
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900">Movimientos de stock recientes</h3>
            <a asp-controller="Stock" asp-action="Movimientos"
               class="text-xs font-medium transition-colors" style="color:#FC651F;"
               onmouseover="this.style.color='#e0541a'" onmouseout="this.style.color='#FC651F'">
                Ver todos →
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Fecha</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tipo</th>
                        <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Cant.</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Producto</th>
                        <th class="px-3 py-3 pr-5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Motivo</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @if (Model.UltimosMovimientosStock.Any())
                    {
                        foreach (var m in Model.UltimosMovimientosStock)
                        {
                            var nombreProducto = (Model.ProductosPorId != null && Model.ProductosPorId.TryGetValue(m.ProductoId, out var nombre))
                                ? nombre : $"ID #{m.ProductoId}";
                            var movUrl = Url.Action("Manage", "StockProducto", new { id = m.ProductoId });
                            bool esIngreso = m.Tipo == "INGRESO";
                            <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='@movUrl'">
                                <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm text-gray-500">@FechaCorta(m.Fecha)</td>
                                <td class="whitespace-nowrap px-3 py-3">
                                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @(esIngreso ? "bg-green-50 text-green-700 ring-green-600/20" : "bg-red-50 text-red-700 ring-red-600/10")">
                                        @(esIngreso ? "Ingreso" : "Egreso")
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900 font-medium text-right">@m.Cantidad</td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900 max-w-[140px] truncate">@nombreProducto</td>
                                <td class="whitespace-nowrap px-3 py-3 pr-5 text-sm text-gray-400">@(!string.IsNullOrWhiteSpace(m.Motivo) ? m.Motivo : "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="py-8 text-center text-sm text-gray-400">Sin movimientos recientes</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@* Stock crítico *@
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900">Productos en stock crítico</h3>
        <a asp-controller="Stock" asp-action="Criticos"
           class="text-xs font-medium text-red-600 hover:text-red-800 transition-colors">
            Ver listado completo →
        </a>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                    <th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock actual</th>
                    <th class="px-3 py-3 pr-5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock mínimo</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                @if (Model.ProductosCriticosDestacados != null && Model.ProductosCriticosDestacados.Any())
                {
                    foreach (var prod in Model.ProductosCriticosDestacados)
                    {
                        var prodUrl = Url.Action("Manage", "StockProducto", new { id = prod.Id });
                        <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='@prodUrl'">
                            <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm font-medium text-gray-900">#@prod.Id</td>
                            <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-900">@prod.Nombre</td>
                            <td class="whitespace-nowrap px-3 py-3 text-right">
                                <span class="text-sm font-semibold @(prod.StockActual == 0 ? "text-red-600" : "text-amber-600")">
                                    @prod.StockActual
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-3 py-3 pr-5 text-sm text-gray-500 text-right">@prod.StockMinimo</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="py-8 text-center text-sm text-gray-400">Sin alertas de stock crítico</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Seguridad y roles *@
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900">Seguridad y roles</h3>
        <a asp-controller="Usuario" asp-action="Index"
           class="text-xs font-medium transition-colors" style="color:#FC651F;"
           onmouseover="this.style.color='#e0541a'" onmouseout="this.style.color='#FC651F'">
            Gestionar usuarios →
        </a>
    </div>
    <div class="p-5">
        <p class="text-sm text-gray-500 mb-4">Administradores activos con acceso total al sistema.</p>
        @if (Model.AdministradoresActivos.Any())
        {
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var admin in Model.AdministradoresActivos)
                {
                    <div class="flex items-center gap-3 rounded-lg border border-gray-200 p-3">
                        <div class="h-9 w-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0"
                             style="background-color:#FC651F;">
                            @admin.Nombre.Substring(0, 1).ToUpper()
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">@admin.Nombre</p>
                            <p class="text-xs text-gray-400 truncate">@admin.Email</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-700">
                No se encontraron administradores activos. Revisá la configuración de roles.
            </div>
        }
    </div>
</div>
