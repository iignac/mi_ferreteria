@using mi_ferreteria.ViewModels
@model AuditoriaListadoViewModel
@{
    ViewData["Title"] = "Auditoria de usuarios";
    string FechaLocal(DateTimeOffset fecha) => fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    bool HayFiltro() => Model?.TieneFiltrosActivos == true;
    string FechaInput(DateTimeOffset? fecha) => fecha?.ToString("yyyy-MM-dd") ?? string.Empty;
    var pgStart = System.Math.Max(1, Model.Page - 2);
    var pgEnd = System.Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Auditoría de acciones
        </h2>
        <p class="mt-1 text-sm text-gray-500">Registro de todo lo que hacen los usuarios. Solo lectura para administradores.</p>
    </div>
    <span class="mt-3 sm:mt-0 inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">Solo administradores</span>
</div>

<div class="rounded-xl border border-gray-200 bg-white shadow-sm mb-4 p-5">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h5 class="text-sm font-semibold text-gray-900">Últimos movimientos</h5>
            <p class="text-xs text-gray-500 mt-0.5">@Model.TotalCount registros en total</p>
        </div>
    </div>

    <form asp-controller="Admin" asp-action="Auditoria" method="get">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Área</label>
                <select name="modulo" class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-3 pr-8 text-sm text-gray-900 focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]">
                    <option value="">Todas</option>
                    @{
                        var modOpts = Model.ModulosDisponibles ?? new List<FiltroOpcion>();
                    }
                    @foreach (var opt in modOpts)
                    {
                        var selected = string.Equals(opt.Value, Model.SelectedModulo, StringComparison.OrdinalIgnoreCase);
                        if (selected)
                        {
                            <option value="@opt.Value" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Operación</label>
                <select name="operacion" class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-3 pr-8 text-sm text-gray-900 focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]">
                    <option value="">Todas</option>
                    @{
                        var operOpts = Model.OperacionesDisponibles ?? new List<FiltroOpcion>();
                    }
                    @foreach (var opt in operOpts)
                    {
                        var selected = string.Equals(opt.Value, Model.SelectedOperacion, StringComparison.OrdinalIgnoreCase);
                        if (selected)
                        {
                            <option value="@opt.Value" selected>@opt.Label</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Desde</label>
                <input type="date" name="desde" value="@FechaInput(Model.FechaDesde)"
                       class="block w-full rounded-lg border border-gray-300 bg-white py-2 px-3 text-sm text-gray-900 focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Hasta</label>
                <input type="date" name="hasta" value="@FechaInput(Model.FechaHasta)"
                       class="block w-full rounded-lg border border-gray-300 bg-white py-2 px-3 text-sm text-gray-900 focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Texto libre</label>
                <input type="text" name="search" value="@(Model.SearchTerm ?? string.Empty)" placeholder="Palabra clave"
                       class="block w-full rounded-lg border border-gray-300 bg-white py-2 px-3 text-sm text-gray-900 placeholder-gray-400 focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]" />
            </div>
            <div class="flex items-center gap-2">
                <button type="submit"
                        class="group flex items-center justify-center rounded-lg bg-gray-900 p-2.5 text-white shadow-sm transition-colors duration-200 hover:bg-[#FC651F] focus:outline-none"
                        title="Aplicar filtros">
                    <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
                    </svg>
                </button>
                @if (HayFiltro())
                {
                    <a asp-controller="Admin" asp-action="Auditoria"
                       class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900">
                        Limpiar
                    </a>
                }
            </div>
        </div>
    </form>

    @if (HayFiltro())
    {
        <div class="mt-3 flex flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedModuloLabel))
            {
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Área: @Model.SelectedModuloLabel</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedOperacionLabel))
            {
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Operación: @Model.SelectedOperacionLabel</span>
            }
            @if (Model.FechaDesde.HasValue)
            {
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Desde: @Model.FechaDesde.Value.ToString("dd/MM/yyyy")</span>
            }
            @if (Model.FechaHasta.HasValue)
            {
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Hasta: @Model.FechaHasta.Value.ToString("dd/MM/yyyy")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Texto: "@Model.SearchTerm"</span>
            }
        </div>
    }
</div>

@if (Model.Registros == null || Model.Registros.Count == 0)
{
    var mensaje = HayFiltro()
        ? "No se encontraron registros que coincidan con los filtros aplicados."
        : "Aún no hay eventos registrados.";
    <div class="text-center rounded-lg bg-gray-50 p-12 border border-dashed border-gray-300">
        <p class="text-sm text-gray-500">@mensaje</p>
    </div>
}
else
{
    <div class="mt-2 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 table-products">
                        <thead>
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-white sm:pl-6">Fecha</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Usuario</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Acción</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Detalle</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var item in Model.Registros)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6">@FechaLocal(item.Fecha)</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="font-medium text-gray-900">@item.UsuarioNombre</div>
                                        <div class="text-xs text-gray-400">ID @item.UsuarioId</div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-gray-900">@item.Accion</td>
                                    <td class="px-3 py-4 text-sm text-gray-500">@item.Detalle</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 mt-2 rounded-b-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                <a asp-controller="Admin" asp-action="Auditoria" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.SearchTerm" asp-route-modulo="@Model.SelectedModulo" asp-route-operacion="@Model.SelectedOperacion" asp-route-desde="@FechaInput(Model.FechaDesde)" asp-route-hasta="@FechaInput(Model.FechaHasta)"
                   class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(Model.Page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                <a asp-controller="Admin" asp-action="Auditoria" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.SearchTerm" asp-route-modulo="@Model.SelectedModulo" asp-route-operacion="@Model.SelectedOperacion" asp-route-desde="@FechaInput(Model.FechaDesde)" asp-route-hasta="@FechaInput(Model.FechaHasta)"
                   class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(Model.Page >= Model.TotalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <p class="text-sm text-gray-700">Página <span class="font-medium">@Model.Page</span> de <span class="font-medium">@Model.TotalPages</span></p>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    <a asp-controller="Admin" asp-action="Auditoria" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.SearchTerm" asp-route-modulo="@Model.SelectedModulo" asp-route-operacion="@Model.SelectedOperacion" asp-route-desde="@FechaInput(Model.FechaDesde)" asp-route-hasta="@FechaInput(Model.FechaHasta)"
                       class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(Model.Page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Anterior</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                    </a>
                    @for (var i = pgStart; i <= pgEnd; i++)
                    {
                        if (i == Model.Page)
                        {
                            <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                        }
                        else
                        {
                            <a asp-controller="Admin" asp-action="Auditoria" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-modulo="@Model.SelectedModulo" asp-route-operacion="@Model.SelectedOperacion" asp-route-desde="@FechaInput(Model.FechaDesde)" asp-route-hasta="@FechaInput(Model.FechaHasta)"
                               class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20">@i</a>
                        }
                    }
                    <a asp-controller="Admin" asp-action="Auditoria" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.SearchTerm" asp-route-modulo="@Model.SelectedModulo" asp-route-operacion="@Model.SelectedOperacion" asp-route-desde="@FechaInput(Model.FechaDesde)" asp-route-hasta="@FechaInput(Model.FechaHasta)"
                       class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(Model.Page >= Model.TotalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Siguiente</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                    </a>
                </nav>
            </div>
        </div>
    }
}
