@model FinanzasDashboardViewModel
@using System.Collections.Generic
@{
    ViewData["Title"] = "Tablero financiero";
    var r = Model.Resumen;
    var diasTop = Model.DiasTopProductos;
    var diasTopClientes = Model.DiasTopClientes;
    var categoriaSeleccionada = Model.CategoriaTopProductosId;
    var categorias = Model.Categorias ?? new List<Categoria>();
    string Mon(decimal v) => v.ToString("C");
    string Porc(decimal v) => $"{v:0.##}%";
    string Dia(double? d) => d.HasValue ? $"{d.Value:F1} días" : "Sin datos";
}

<div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Tablero financiero
        </h2>
        <p class="mt-1 text-sm text-gray-500">Ventas, margen y cobranzas.</p>
    </div>
    <span class="mt-3 sm:mt-0 inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold text-white" style="background-color:#FC651F;">
        Solo administradores
    </span>
</div>

@* Tarjetas resumen principales *@
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-4">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Total vendido</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">@Mon(r.TotalVendido)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Margen bruto (%)</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">@Porc(r.MargenBrutoPorcentaje)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Deuda total</p>
        <p class="text-2xl font-bold text-red-600 mt-1">@Mon(r.DeudaTotal)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Promedio de cobro</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">@Dia(r.PromedioCobroDias)</p>
    </div>
</div>

@* Tarjetas ventas por período *@
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Ventas del día</p>
        <p class="text-xl font-bold text-gray-900 mt-1">@Mon(r.VentasDia)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Ventas de la semana</p>
        <p class="text-xl font-bold text-gray-900 mt-1">@Mon(r.VentasSemana)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Ventas del mes</p>
        <p class="text-xl font-bold text-gray-900 mt-1">@Mon(r.VentasMes)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <p class="text-sm text-gray-500">Ventas del año</p>
        <p class="text-xl font-bold text-gray-900 mt-1">@Mon(r.VentasAnio)</p>
    </div>
</div>

@* Top productos y top clientes *@
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-6">

    @* Top 5 productos *@
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 flex-wrap gap-2">
            <h3 class="text-sm font-semibold text-gray-900">Top 5 productos</h3>
            <form method="get" asp-controller="Admin" asp-action="Finanzas" class="flex items-center gap-2 flex-wrap">
                <input type="hidden" name="diasTopClientes" value="@diasTopClientes" />
                <label for="topProductosCategoria" class="text-xs text-gray-500">Categoría</label>
                <select id="topProductosCategoria" name="categoriaTopProductosId"
                        class="rounded-md border border-gray-300 bg-white px-2 py-1 text-xs text-gray-700 shadow-sm focus:outline-none focus:ring-1" style="focus:ring-color:#FC651F;">
                    @if (categoriaSeleccionada == null)
                    {
                        <option value="" selected>Todas</option>
                    }
                    else
                    {
                        <option value="">Todas</option>
                    }
                    @foreach (var cat in categorias)
                    {
                        @if (categoriaSeleccionada == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Nombre</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Nombre</option>
                        }
                    }
                </select>
                <label for="topProductosRango" class="text-xs text-gray-500">Período</label>
                <select id="topProductosRango" name="diasTopProductos"
                        class="rounded-md border border-gray-300 bg-white px-2 py-1 text-xs text-gray-700 shadow-sm focus:outline-none">
                    @if (diasTop == 30) { <option value="30" selected>Últimos 30 días</option> } else { <option value="30">Últimos 30 días</option> }
                    @if (diasTop == 90) { <option value="90" selected>Últimos 90 días</option> } else { <option value="90">Últimos 90 días</option> }
                </select>
                <button type="submit"
                        class="rounded-md px-2.5 py-1 text-xs font-medium text-white transition-colors hover:opacity-90"
                        style="background-color:#FC651F;">
                    Aplicar
                </button>
            </form>
        </div>
        <div class="overflow-x-auto">
            @if (r.TopProductos.Count == 0)
            {
                <p class="py-8 text-center text-sm text-gray-400">Sin datos de ventas.</p>
            }
            else
            {
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Producto</th>
                            <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Cantidad</th>
                            <th class="px-3 py-3 pr-5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Importe</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-white">
                        @foreach (var p in r.TopProductos)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm text-gray-900">@p.Nombre</td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500 text-right">@p.CantidadVendida</td>
                                <td class="whitespace-nowrap px-3 py-3 pr-5 text-sm font-medium text-gray-900 text-right">@Mon(p.ImporteTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Clientes que más compran *@
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 flex-wrap gap-2">
            <h3 class="text-sm font-semibold text-gray-900">Clientes que más compran</h3>
            <form method="get" asp-controller="Admin" asp-action="Finanzas" class="flex items-center gap-2">
                <input type="hidden" name="diasTopProductos" value="@diasTop" />
                <input type="hidden" name="categoriaTopProductosId" value="@(categoriaSeleccionada?.ToString() ?? string.Empty)" />
                <label for="topClientesRango" class="text-xs text-gray-500">Período</label>
                <select id="topClientesRango" name="diasTopClientes"
                        class="rounded-md border border-gray-300 bg-white px-2 py-1 text-xs text-gray-700 shadow-sm focus:outline-none"
                        onchange="this.form.submit()">
                    @if (diasTopClientes == 30) { <option value="30" selected>Últimos 30 días</option> } else { <option value="30">Últimos 30 días</option> }
                    @if (diasTopClientes == 90) { <option value="90" selected>Últimos 90 días</option> } else { <option value="90">Últimos 90 días</option> }
                </select>
                <noscript>
                    <button type="submit"
                            class="rounded-md px-2.5 py-1 text-xs font-medium text-white transition-colors hover:opacity-90"
                            style="background-color:#FC651F;">
                        Aplicar
                    </button>
                </noscript>
            </form>
        </div>
        <div class="overflow-x-auto">
            @if (r.TopClientes.Count == 0)
            {
                <p class="py-8 text-center text-sm text-gray-400">Sin compras registradas.</p>
            }
            else
            {
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Cliente</th>
                            <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Compras</th>
                            <th class="px-3 py-3 pr-5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Importe</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-white">
                        @foreach (var c in r.TopClientes)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm text-gray-900">@c.Nombre</td>
                                <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500 text-right">@c.CantidadCompras</td>
                                <td class="whitespace-nowrap px-3 py-3 pr-5 text-sm font-medium text-gray-900 text-right">@Mon(c.ImporteTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

@* Clientes deudores *@
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-900">Clientes deudores</h3>
        <span class="text-xs text-gray-400">Incluye saldo de cuenta corriente</span>
    </div>
    <div class="overflow-x-auto">
        @if (r.Deudores.Count == 0)
        {
            <p class="py-8 text-center text-sm text-gray-400">Sin deudas pendientes.</p>
        }
        else
        {
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="py-3 pl-5 pr-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Cliente</th>
                        <th class="px-3 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Deuda</th>
                        <th class="px-3 py-3 pr-5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Límite crédito</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var d in r.Deudores)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="whitespace-nowrap py-3 pl-5 pr-3 text-sm text-gray-900">@d.Nombre</td>
                            <td class="whitespace-nowrap px-3 py-3 text-sm font-medium text-red-600 text-right">@Mon(d.DeudaTotal)</td>
                            <td class="whitespace-nowrap px-3 py-3 pr-5 text-sm text-gray-500 text-right">@Mon(d.LimiteCredito)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
