@model IEnumerable<mi_ferreteria.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
    string q = ViewBag.Query as string ?? string.Empty;
    string sort = ViewBag.Sort as string ?? "id_asc";
    bool canManageCategorias = User.IsInRole("Administrador") || User.IsInRole("Stock");
    string NextSort(string col) {
        return col switch {
            "id" => sort == "id_asc" ? "id_desc" : "id_asc",
            "nombre" => sort == "nombre_asc" ? "nombre_desc" : "nombre_asc",
            "activo" => sort == "activo_asc" ? "activo_desc" : "activo_asc",
            _ => "id_asc"
        };
    }
    string Arrow(string col) {
        if (col == "id" && sort.StartsWith("id_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "nombre" && sort.StartsWith("nombre_")) return sort.EndsWith("asc") ? "↑" : "↓";
        if (col == "activo" && sort.StartsWith("activo_")) return sort.EndsWith("asc") ? "↑" : "↓";
        return "↕";
    }
    var catNames = ViewBag.CategoriaNames as System.Collections.Generic.IDictionary<long, string>;
}

<div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Categorías
        </h2>
        <p class="mt-2 text-sm text-gray-700">Gestione la jerarquía de categorías para organizar el catálogo de productos.</p>
    </div>
    @if (canManageCategorias)
    {
        <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
            <button type="button" onclick="openAjaxModal('@Url.Action("Create")')" class="block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors">
                Crear categoría
            </button>
        </div>
    }
</div>

<div class="mb-6 bg-white p-4 shadow-sm rounded-lg border border-gray-200">
    <form method="get" asp-action="Index" class="flex items-center gap-4">
        <div class="flex-grow max-w-lg">
            <label for="search" class="sr-only">Buscar categorías</label>
            <div class="relative rounded-md shadow-sm">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                    </svg>
                </div>
                <input type="search" name="q" id="search" value="@q" class="block w-full rounded-md border-0 py-1.5 pl-10 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" placeholder="Buscar por nombre de categoría" />
            </div>
        </div>
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="sort" value="@sort" />
        <button type="submit" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors">
            Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="Index" class="text-sm font-semibold leading-6 text-gray-900 hover:text-gray-600 transition-colors">Limpiar</a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="rounded-md bg-blue-50 p-4 shadow-sm border border-blue-100">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1 md:flex md:justify-between">
                <p class="text-sm text-blue-700">No hay categorías para mostrar.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="mt-4 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 table-products">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("id")' asp-route-page="1" class="group inline-flex hover:text-indigo-600">
                                        ID
                                        <span class="ml-2 flex-none rounded text-gray-400 group-hover:bg-gray-200">@Html.Raw(Arrow("id"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("nombre")' asp-route-page="1" class="group inline-flex hover:text-indigo-600">
                                        Nombre
                                        <span class="ml-2 flex-none rounded text-gray-400 group-hover:bg-gray-200">@Html.Raw(Arrow("nombre"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Padre</th>
                                <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900">
                                    <a asp-action="Index" asp-route-q="@q" asp-route-sort='@NextSort("activo")' asp-route-page="1" class="group inline-flex hover:text-indigo-600">
                                        Estado
                                        <span class="ml-2 flex-none rounded text-gray-400 group-hover:bg-gray-200">@Html.Raw(Arrow("activo"))</span>
                                    </a>
                                </th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-sm font-semibold text-gray-900">
                                    <span class="sr-only">Acciones</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            @foreach (var c in Model)
                            {
                                var rowHref = canManageCategorias ? Url.Action("Edit","Categoria", new { id = c.Id }) : null;
                                var rowClass = canManageCategorias ? "clickable-row hover:bg-gray-50 cursor-pointer transition-colors" : "hover:bg-gray-50 transition-colors";
                                
                                <tr class="@rowClass" data-href="@rowHref">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">@c.Id</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                        <div class="font-medium text-gray-900">@c.Nombre</div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                        @if (c.IdPadre.HasValue && catNames != null && catNames.ContainsKey(c.IdPadre.Value))
                                        {
                                            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">@catNames[c.IdPadre.Value]</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">(-)</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 text-center">
                                        @if (c.Activo)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactivo</span>
                                        }
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        @if (canManageCategorias)
                                        {
                                            <button type="button" onclick="event.stopPropagation(); openAjaxModal('@Url.Action("Edit", new { id = c.Id })')" class="text-indigo-600 hover:text-indigo-900 mr-2" aria-label="Editar">Editar</button>
                                            
                                            @if (c.Activo)
                                            {
                                                <a asp-action="Delete" asp-route-id="@c.Id" class="text-yellow-600 hover:text-yellow-900 mr-2" aria-label="Desactivar">Desactivar</a>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" method="post" class="inline">
                                                    <input type="hidden" name="id" value="@c.Id" />
                                                    <button type="submit" class="text-green-600 hover:text-green-900 mr-2" aria-label="Activar">Activar</button>
                                                </form>
                                            }
                                            
                                            <form asp-action="HardDelete" method="post" class="inline">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="text-red-600 hover:text-red-900 btn-hard-delete" aria-label="Eliminar Físicamente">Eliminar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 text-xs uppercase tracking-wider">Solo lectura</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@{
    int page = ViewBag.Page is int ? (int)ViewBag.Page : 1;
    int totalPages = ViewBag.TotalPages is int ? (int)ViewBag.TotalPages : 1;
}
@if (totalPages > 1)
{
    var start = System.Math.Max(1, page - 2);
    var end = System.Math.Min(totalPages, page + 2);
    
    <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-6 shadow sm:rounded-lg">
        <div class="flex flex-1 justify-between sm:hidden">
            <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
            <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
        </div>
        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
                <p class="text-sm text-gray-700">
                    Página <span class="font-medium">@(page)</span> de <span class="font-medium">@totalPages</span>
                </p>
            </div>
            <div>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 focus:outline-offset-0 @(page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Anterior</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                        </svg>
                    </a>

                    @for (var i = start; i <= end; i++)
                    {
                        if (i == page)
                        {
                            <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@i" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20 focus:outline-offset-0">@i</a>
                        }
                    }

                    <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-sort="@sort" class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 focus:outline-offset-0 @(page >= totalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Siguiente</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </nav>
            </div>
        </div>
    </div>
}

    <!-- AJX Modal Container -->
    <div id="ajax-modal-container" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div id="ajax-modal-backdrop" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity opacity-0 z-50"></div>

        <div class="fixed inset-0 z-50 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div id="ajax-modal-content" class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl sm:p-6 opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
                    
                    <!-- Close Button -->
                    <div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
                        <button type="button" onclick="closeAjaxModal()" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                            <span class="sr-only">Close</span>
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>

                    <!-- Loading Spinner -->
                    <div id="ajax-modal-loading" class="flex flex-col items-center justify-center py-10">
                        <svg class="animate-spin h-8 w-8 text-indigo-600 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span class="text-sm text-gray-500">Cargando...</span>
                    </div>

                    <!-- Injected Content -->
                    <div id="ajax-modal-body" class="hidden"></div>
                    
                </div>
            </div>
        </div>
    </div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    document.addEventListener('DOMContentLoaded', function(){
      document.querySelectorAll('table.table-products tbody tr.clickable-row').forEach(function(tr){
        tr.addEventListener('click', function(e){
          var t = e.target;
          if (t && t.closest && (t.closest('a') || t.closest('button') || t.closest('form'))) return;
          var href = this.getAttribute('data-href');
          if (href) openAjaxModal(href);
        });
      });
      document.querySelectorAll('.btn-hard-delete').forEach(function(btn){
        btn.addEventListener('click', function(e){
          if(!confirm('¿Eliminar físicamente esta categoría? Esta acción no se puede deshacer.')){
            e.preventDefault();
          }
        });
      });

      // Click outside to close map
      document.getElementById('ajax-modal-container').addEventListener('click', function(e) {
          if (e.target === document.querySelector('.fixed.inset-0.z-50.overflow-y-auto > div')) {
              closeAjaxModal();
          }
      });
    });

    function openAjaxModal(url) {
        const container = document.getElementById('ajax-modal-container');
        const backdrop = document.getElementById('ajax-modal-backdrop');
        const content = document.getElementById('ajax-modal-content');
        const body = document.getElementById('ajax-modal-body');
        const loading = document.getElementById('ajax-modal-loading');

        body.innerHTML = '';
        body.classList.add('hidden');
        loading.classList.remove('hidden');

        container.classList.remove('hidden');
        setTimeout(() => {
            backdrop.classList.remove('opacity-0');
            content.classList.remove('opacity-0', 'translate-y-4', 'sm:scale-95');
            content.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
        }, 10);

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(res => res.text())
        .then(html => {
            loading.classList.add('hidden');
            body.innerHTML = html;
            body.classList.remove('hidden');
            
            if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                const form = body.querySelector('form');
                if (form) window.jQuery.validator.unobtrusive.parse(form);
            }

            Array.from(body.querySelectorAll('script')).forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                oldScript.parentNode.replaceChild(newScript, oldScript);
            });

            setupAjaxForm(body.querySelector('form'));
        })
        .catch(err => {
            console.error('Error fetching modal content', err);
            body.innerHTML = '<div class="p-4 bg-red-50 text-red-700 rounded-md">Error cargando contenido.</div>';
            loading.classList.add('hidden');
            body.classList.remove('hidden');
        });
    }

    function closeAjaxModal() {
        const container = document.getElementById('ajax-modal-container');
        const backdrop = document.getElementById('ajax-modal-backdrop');
        const content = document.getElementById('ajax-modal-content');

        backdrop.classList.add('opacity-0');
        content.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
        content.classList.add('opacity-0', 'translate-y-4', 'sm:scale-95');
        
        setTimeout(() => { container.classList.add('hidden'); }, 300);
    }

    function setupAjaxForm(form) {
        if (!form) return;
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (window.jQuery && window.jQuery(form).valid && !window.jQuery(form).valid()) {
                return;
            }

            const formData = new FormData(form);
            const url = form.getAttribute('action');
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = 'Guardando...';
            }

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(async res => {
                const contentType = res.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const data = await res.json();
                    if (data.success) {
                        closeAjaxModal();
                        window.location.reload();
                    }
                } else {
                    const html = await res.text();
                    const body = document.getElementById('ajax-modal-body');
                    body.innerHTML = html;
                    setupAjaxForm(body.querySelector('form'));
                }
            })
            .catch(err => {
                console.error('Error submitting form', err);
                if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalText; }
            });
        });
    }
</script>
}
