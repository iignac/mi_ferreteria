@model mi_ferreteria.ViewModels.UsuarioFormViewModel
@{
    if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Crear Usuario";
    }
}

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
<div class="md:flex md:items-center md:justify-between mb-6">
    <div class="min-w-0 flex-1">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Crear Usuario
        </h2>
    </div>
</div>
}
else
{
    <div class="mb-4">
        <h3 class="text-xl font-bold leading-7 text-gray-900">Crear Usuario</h3>
    </div>
}

<style>
    .role-card {
        position: relative;
        transition: border-color .2s ease, box-shadow .25s ease, background .25s ease, transform .25s ease;
        overflow: hidden;
    }

    .role-card::after {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 1rem;
        background: radial-gradient(circle at top, rgba(129, 140, 248, .25), transparent 55%);
        opacity: 0;
        transition: opacity .3s ease;
        pointer-events: none;
    }

    .role-card > * {
        position: relative;
        z-index: 1;
    }

    .role-card:has(input:checked) {
        background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
        border-color: #4f46e5;
        box-shadow: 0 20px 25px -15px rgba(79, 70, 229, .55);
        transform: translateY(-2px);
    }

    .role-card:has(input:checked)::after {
        opacity: 1;
    }

    .role-card:focus-within {
        box-shadow: 0 0 0 2px rgba(99, 102, 241, .3), 0 18px 20px -15px rgba(79, 70, 229, .35);
    }

    .role-card.role-card--disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .role-card.role-card--disabled:after {
        opacity: 0;
    }

    .password-tooltip {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .password-tooltip__button {
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 9999px;
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #4338ca;
        font-size: .75rem;
        font-weight: 600;
        transition: background .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .password-tooltip__button:hover,
    .password-tooltip__button:focus-visible {
        background: #4338ca;
        color: #fff;
        border-color: #4338ca;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, .3);
    }

    .password-tooltip__panel {
        position: absolute;
        top: calc(100% + .5rem);
        left: calc(100% + .75rem);
        width: min(20rem, 75vw);
        padding: .75rem;
        border-radius: .75rem;
        background: rgba(17, 24, 39, .96);
        color: #f9fafb;
        font-size: .85rem;
        box-shadow: 0 20px 30px -20px rgba(15, 23, 42, .65);
        line-height: 1.4;
        opacity: 0;
        visibility: hidden;
        transform: translate(-4px, -4px);
        transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        z-index: 10;
    }

    .password-tooltip__panel strong {
        display: block;
        color: #c7d2fe;
        margin-bottom: .5rem;
        font-size: .8rem;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .password-tooltip__panel ul {
        list-style: disc;
        padding-left: 1.2rem;
        margin: 0;
    }

    .password-tooltip__panel li + li {
        margin-top: .35rem;
    }

    .password-tooltip:focus-within .password-tooltip__panel,
    .password-tooltip:hover .password-tooltip__panel {
        opacity: 1;
        visibility: visible;
        transform: translate(0, 0);
    }

</style>

<div class="@(Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? "" : "bg-white shadow sm:rounded-lg mb-8")">
    <div class="@(Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? "pt-2" : "px-4 py-5 sm:p-6")">
        <div class="text-red-600 mb-4 text-sm font-medium" asp-validation-summary="ModelOnly"></div>
        
        <form asp-action="Create" method="post" data-unsaved-warning="true" class="space-y-8">
            
            <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium leading-6 text-gray-900">Nombre</label>
                    <div class="mt-2 text-red-600">
                        <input asp-for="Nombre" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Nombre" class="text-sm mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium leading-6 text-gray-900">Email</label>
                    <div class="mt-2 text-red-600">
                        <input asp-for="Email" type="email" autocomplete="email" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Email" class="text-sm mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-2">
                        <label asp-for="Password" class="block text-sm font-medium leading-6 text-gray-900">Contraseña</label>
                        <span class="password-tooltip">
                            <button type="button"
                                    class="password-tooltip__button"
                                    aria-describedby="password-tooltip-create"
                                    aria-label="Ver requisitos de contraseña">i</button>
                            <div id="password-tooltip-create" role="tooltip" class="password-tooltip__panel">
                                <strong>Requisitos</strong>
                                <ul>
                                    <li>Mínimo 10 caracteres.</li>
                                    <li>Al menos una mayúscula, una minúscula y un número.</li>
                                    <li>Al menos un carácter especial.</li>
                                    <li>No repetir el mismo carácter en más de la mitad del total.</li>
                                </ul>
                            </div>
                        </span>
                    </div>
                    <div class="mt-2 text-red-600">
                        <input asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               title="La contraseña debe incluir:&#10;• Mínimo 10 caracteres.&#10;• Al menos una mayúscula, una minúscula y un número.&#10;• Al menos un carácter especial.&#10;• No repetir el mismo carácter en más de la mitad del total."
                               class="data-pw block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="Password" class="text-sm mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium leading-6 text-gray-900">Confirmar contraseña</label>
                    <div class="mt-2 text-red-600">
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="data-pw block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                        <span asp-validation-for="ConfirmPassword" class="text-sm mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-6">
                <div class="flex items-center justify-between max-w-lg">
                    <span class="flex flex-grow flex-col">
                        <span class="text-sm font-medium leading-6 text-gray-900" id="activo-label">Estado de usuario</span>
                        <span class="text-sm text-gray-500" id="activo-description">Define si el usuario puede ingresar al sistema.</span>
                    </span>
                    <label class="relative inline-flex items-center gap-3 ml-4">
                        <span class="text-xs font-semibold text-gray-500">Inactivo</span>
                        <div class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" asp-for="Activo" class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-indigo-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                        </div>
                        <span class="text-xs font-semibold text-gray-900">Activo</span>
                    </label>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-6 space-y-4">
                <div class="rounded-lg border border-indigo-100 bg-indigo-50/50">
                    <details class="group">
                        <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-semibold text-indigo-900">
                            ¿Cómo se gestionan los roles y permisos?
                            <span class="ml-2 text-indigo-500 transition-transform group-open:rotate-180">⌄</span>
                        </summary>
                        <div class="border-t border-indigo-100 bg-white/70 px-4 py-4">
                            <ul class="list-disc space-y-2 pl-5 text-sm text-indigo-900">
                                <li>Cada rol tiene un conjunto de permisos predefinidos (heredados).</li>
                                <li>El rol Administrador tiene la totalidad de los permisos.</li>
                                <li>Los roles Vendedor y Stock pueden seleccionarse de forma conjunta (se suman los permisos de ambos roles).</li>
                                <li>Si seleccionás el rol Vendedor, Stock, o ambos, podés sumar permisos adicionales (manuales) a los heredados.</li>
                                <li>También podés dejar todos los roles sin marcar y seleccionar solo permisos manuales.</li>
                            </ul>
                        </div>
                    </details>
                </div>
                <fieldset data-role-selector="true">
                    <legend class="text-sm font-semibold leading-6 text-gray-900">Seleccione rol</legend>
                    <div class="mt-4 grid grid-cols-1 gap-y-6 sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-4">
                        @foreach (var rol in Model.RolesDisponibles)
                        {
                            var permisosAsignadosAlRol = Model.PermisosPorRol != null && Model.PermisosPorRol.TryGetValue(rol.Id, out var listaRol) && listaRol != null
                                ? listaRol
                                : new List<int>();
                            var permisosRolCsv = permisosAsignadosAlRol.Count > 0 ? string.Join(",", permisosAsignadosAlRol) : string.Empty;
                            <label class="role-card relative flex cursor-pointer rounded-lg border bg-white p-4 shadow-sm focus:outline-none border-gray-300 hover:border-indigo-400 transition-colors [&:has(:checked)]:border-indigo-600 [&:has(:checked)]:ring-1 [&:has(:checked)]:ring-indigo-600 [&:has(:checked)]:bg-indigo-50/50">
                                <input type="checkbox" name="RolesIds" value="@rol.Id" data-role-name="@rol.Nombre" data-role-id="@rol.Id" data-role-permisos="@permisosRolCsv" class="sr-only peer" @(Model.RolesIds != null && Model.RolesIds.Contains(rol.Id) ? "checked" : "")>
                                <span class="flex flex-1">
                                    <span class="flex flex-col">
                                        <span class="block text-sm font-medium text-gray-900">@rol.Nombre</span>
                                        <span class="mt-1 flex items-center text-sm text-gray-500">@rol.Descripcion</span>
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="RolesIds" class="block text-sm text-red-600 mt-2"></span>
                </fieldset>
            </div>

            <div class="border-t border-gray-200 pt-6">
                <div class="flex items-start gap-2">
                    <div class="flex items-center gap-2">
                        <h3 class="text-sm font-semibold leading-6 text-gray-900">Seleccione permisos manuales</h3>
                        <span class="password-tooltip">
                            <button type="button"
                                    class="password-tooltip__button"
                                    aria-describedby="manual-perms-tooltip-create"
                                    aria-label="Ver ayuda para permisos manuales">i</button>
                            <div id="manual-perms-tooltip-create" role="tooltip" class="password-tooltip__panel">
                                <strong>Permisos manuales</strong>
                                <ul>
                                    <li>Los permisos heredados aparecen marcados, deshabilitados y con la etiqueta “Heredado”.</li>
                                    <li>Puedes sumar permisos manuales activando los interruptores disponibles.</li>
                                    <li>Al quitar un rol, los permisos heredados que dependían de él vuelven a su estado manual anterior.</li>
                                </ul>
                            </div>
                        </span>
                    </div>
                </div>

                @if (Model.TodosLosPermisos != null && Model.TodosLosPermisos.Any())
                {
                    var permisosPorGrupo = Model.TodosLosPermisos
                        .GroupBy(p => p.Nombre.Split('.').FirstOrDefault() ?? "Otros")
                        .OrderBy(g => g.Key);

                    <div class="divide-y divide-gray-200 border-b border-t border-gray-200">
                        @foreach (var grupo in permisosPorGrupo)
                        {
                            <div x-data="{ open: false }" class="pt-4 pb-4">
                                <button type="button" @@click="open = !open" class="flex w-full items-center justify-between text-left focus:outline-none bg-gray-50/50 p-3 rounded-md hover:bg-gray-100 transition-colors">
                                    <span class="text-sm font-medium text-gray-900">Módulo: @grupo.Key</span>
                                    <span class="ml-6 flex items-center">
                                        <svg class="h-5 w-5 transform transition-transform duration-200 text-gray-400" :class="{ 'rotate-180': open }" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                        </svg>
                                    </span>
                                </button>
                                <div x-show="open" x-collapse>
                                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 px-2 pb-2">
                                        @foreach (var permiso in grupo.OrderBy(p => p.Nombre))
                                        {
                                            var isHeredado = Model.PermisosHeredados != null && Model.PermisosHeredados.Contains(permiso.Nombre);
                                            var isDirecto = Model.PermisosIds != null && Model.PermisosIds.Contains(permiso.Id);

                                            <div class="relative flex items-start py-3 border rounded-lg px-4 bg-white shadow-sm hover:border-gray-400 transition-colors" data-perm-item>
                                                <div class="min-w-0 flex-1 text-sm leading-6">
                                                    <label for="permiso_create_@permiso.Id" class="font-medium text-gray-900 select-none">@permiso.Nombre.Split('.').LastOrDefault()</label>
                                                    <p class="text-gray-500 text-xs">@permiso.Descripcion</p>
                                                    <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10 mt-1 @(isHeredado ? "" : "hidden")" data-perm-badge>Heredado</span>
                                                </div>
                                                <div class="ml-3 flex h-6 items-center flex-shrink-0">
                                                    <input id="permiso_create_@permiso.Id"
                                                           name="PermisosIds"
                                                           value="@permiso.Id"
                                                           type="checkbox"
                                                           @(isDirecto || isHeredado ? "checked" : "")
                                                           @(isHeredado ? "disabled" : "")
                                                           class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600 disabled:opacity-50 @(isHeredado ? "cursor-not-allowed" : "cursor-pointer")"
                                                           data-perm-checkbox="true"
                                                           data-perm-id="@permiso.Id"
                                                           data-perm-nombre="@permiso.Nombre"
                                                           data-inherited="@(isHeredado ? "true" : "false")"
                                                           data-manual-checked="@(isDirecto ? "true" : "false")" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-md bg-blue-50 p-4">
                        <p class="text-sm text-blue-700">No hay permisos configurados para asignar.</p>
                    </div>
                }
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-4 border-t border-gray-200 pt-6">
                @if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
                {
                    <button type="button" onclick="closeAjaxModal()" class="text-sm font-semibold leading-6 text-gray-900 hover:text-gray-600 transition-colors px-4 py-2">Cancelar</button>
                }
                else
                {
                    <a asp-action="Index" class="btn-cancel-leave text-sm font-semibold leading-6 text-gray-900 hover:text-gray-600 transition-colors px-4 py-2">Cancelar</a>
                }
                <button type="submit" class="rounded-md bg-indigo-600 px-6 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors">Guardar Usuario</button>
            </div>
        </form>
    </div>
</div>

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
        <script>
        (function () {
            const roleSelector = document.querySelector('[data-role-selector]');
            if (!roleSelector) return;
            const checkboxes = Array.from(roleSelector.querySelectorAll('input[name="RolesIds"]'));
            if (!checkboxes.length) return;

            const normalizeKey = (text) => (text || '')
                .toString()
                .normalize('NFD')
                .replace(/[̀-ͯ]/g, '')
                .toLowerCase()
                .replace(/[^a-z0-9]/g, '');

            const getKey = (checkbox) => {
                if (checkbox.dataset.roleKeyNormalized) return checkbox.dataset.roleKeyNormalized;
                const label = checkbox.closest('label');
                const raw = checkbox.getAttribute('data-role-name') ?? (label ? label.innerText : '');
                const key = normalizeKey(raw);
                checkbox.dataset.roleKeyNormalized = key;
                return key;
            };

            const buildMatcher = (keys) => checkboxes.filter(cb => {
                const key = getKey(cb);
                return keys.some(target => key === target || key.includes(target));
            });

            const adminChecks = buildMatcher(['administrador']);
            const vendedorChecks = buildMatcher(['vendedor']);
            const stockChecks = buildMatcher(['stock']);
            const disableReason = 'Administrador abarca todas las funciones, no se combina con Vendedor ni Stock.';

            const toggleDisabled = (targets, disabled) => {
                targets.forEach(cb => {
                    const label = cb.closest('label');
                    if (disabled) {
                        cb.checked = false;
                        cb.setAttribute('disabled', 'disabled');
                        if (label) {
                            label.classList.add('role-card--disabled');
                            label.setAttribute('aria-disabled', 'true');
                            label.setAttribute('title', disableReason);
                        }
                    } else {
                        cb.removeAttribute('disabled');
                        if (label) {
                            label.classList.remove('role-card--disabled');
                            label.removeAttribute('aria-disabled');
                            label.removeAttribute('title');
                        }
                    }
                });
            };

            const getRolePermissionIds = (checkbox) => {
                if (checkbox._rolePermissionsCache) {
                    return checkbox._rolePermissionsCache;
                }
                const raw = checkbox.dataset.rolePermisos || '';
                const perms = raw
                    .split(',')
                    .map(id => id.trim())
                    .filter(Boolean);
                checkbox._rolePermissionsCache = perms;
                return perms;
            };

            const updateCardCursor = (card, disabled) => {
                if (!card) return;
                card.classList.toggle('cursor-not-allowed', disabled);
                card.classList.toggle('cursor-pointer', !disabled);
            };

            const setupPermissionCardClicks = (permissionInputs) => {
                permissionInputs.forEach(input => {
                    const card = input.closest('[data-perm-item]');
                    if (!card || card.dataset.permClickBound === 'true') return;
                    card.dataset.permClickBound = 'true';
                    updateCardCursor(card, input.disabled);
                    card.addEventListener('click', (event) => {
                        if (event.target.closest('input[type="checkbox"]')) return;
                        if (input.disabled) return;
                        input.checked = !input.checked;
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                });
            };

            const buildPermissionsSync = () => {
                const permissionInputs = Array.from(document.querySelectorAll('[data-perm-checkbox]'));
                if (!permissionInputs.length) return null;

                const permissionMap = new Map(permissionInputs.map(input => {
                    if (!('manualChecked' in input.dataset)) {
                        input.dataset.manualChecked = input.checked ? 'true' : 'false';
                    }
                    const wrapper = input.closest('[data-perm-item]');
                    const badge = wrapper ? wrapper.querySelector('[data-perm-badge]') : null;
                    return [input.dataset.permId, { input, badge, wrapper }];
                }));

                permissionInputs.forEach(input => {
                    input.addEventListener('change', () => {
                        if (input.dataset.inherited === 'true') return;
                        input.dataset.manualChecked = input.checked ? 'true' : 'false';
                    });
                });

                setupPermissionCardClicks(permissionInputs);

                return () => {
                    const inherited = new Map();
                    checkboxes.filter(cb => cb.checked).forEach(cb => {
                        getRolePermissionIds(cb).forEach(permId => {
                            if (!permId) return;
                            inherited.set(permId, (inherited.get(permId) || 0) + 1);
                        });
                    });

                    permissionMap.forEach(({ input, badge, wrapper }, permId) => {
                        const shouldInherit = inherited.has(permId);
                        const wasInherited = input.dataset.inherited === 'true';
                        if (shouldInherit) {
                            if (!wasInherited) {
                                input.dataset.manualChecked = input.checked ? 'true' : 'false';
                            }
                            input.dataset.inherited = 'true';
                            input.checked = true;
                            input.disabled = true;
                            input.classList.remove('cursor-pointer');
                            input.classList.add('cursor-not-allowed');
                            updateCardCursor(wrapper, true);
                            if (badge) badge.classList.remove('hidden');
                        } else {
                            input.dataset.inherited = 'false';
                            input.disabled = false;
                            input.classList.add('cursor-pointer');
                            input.classList.remove('cursor-not-allowed');
                            updateCardCursor(wrapper, false);
                            if (wasInherited) {
                                input.checked = input.dataset.manualChecked === 'true';
                            }
                            if (badge) badge.classList.add('hidden');
                        }
                    });
                };
            };

            const applyRestrictions = () => {
                const adminActive = adminChecks.some(cb => cb.checked);
                toggleDisabled([...vendedorChecks, ...stockChecks], adminActive);
            };

            const syncPermissions = buildPermissionsSync();

            const handleRoleChange = () => {
                applyRestrictions();
                if (typeof syncPermissions === 'function') {
                    syncPermissions();
                }
            };

            checkboxes.forEach(cb => cb.addEventListener('change', handleRoleChange));
            handleRoleChange();
        })();
    </script>
    <script>
        (function(){
            let isDirty = false;
            const form = document.querySelector('form[asp-action="Create"]');
            if (!form) return;
            form.addEventListener('input', () => { isDirty = true; }, { capture: true });
            form.addEventListener('change', () => { isDirty = true; }, { capture: true });
            form.addEventListener('submit', () => { isDirty = false; });
            window.addEventListener('beforeunload', function (e) {
                if (!isDirty) return;
                e.preventDefault();
                e.returnValue = '';
            });
            document.querySelectorAll('.btn-cancel-leave').forEach(function(a){
                a.addEventListener('click', function(e){
                    if (isDirty && !confirm('Hay cambios sin guardar. Si vuelves, se perderán. ¿Deseas salir igualmente?')) {
                        e.preventDefault();
                    }
                });
            });
        })();
