@model IEnumerable<mi_ferreteria.Models.Usuario>
@using mi_ferreteria.Models
@{
    ViewData["Title"] = "Gestión de Usuarios";
    int page = ViewBag.Page is int p ? p : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var pgStart = System.Math.Max(1, page - 2);
    var pgEnd = System.Math.Min(totalPages, page + 2);
    string q = ViewBag.Q as string ?? string.Empty;
    string activo = ViewBag.Activo as string ?? string.Empty;
    string rolFiltro = ViewBag.Rol as string ?? string.Empty;
    string permisoFiltro = ViewBag.Permiso as string ?? string.Empty;
    var roles = ViewBag.Roles as List<Rol> ?? new List<Rol>();
    var permisos = ViewBag.Permisos as List<Permiso> ?? new List<Permiso>();
    bool hayFiltro = !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(activo) || !string.IsNullOrWhiteSpace(rolFiltro) || !string.IsNullOrWhiteSpace(permisoFiltro);
}

<div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
            Gestión de Usuarios
        </h2>
        <p class="mt-1 text-sm text-gray-500">
            Lista completa de los usuarios del sistema, sus roles y estados.
        </p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
        <button type="button" onclick="openAjaxModal('@Url.Action("Create")')" class="block rounded-md px-4 py-2 text-center text-sm font-semibold text-white shadow-sm transition-colors" style="background-color:#FC651F;" onmouseover="this.style.backgroundColor='#e0541a'" onmouseout="this.style.backgroundColor='#FC651F'">
            Crear usuario
        </button>
    </div>
</div>

<div class="mb-6 bg-white p-4 shadow-sm rounded-lg border border-gray-200">
    <form method="get" asp-action="Index" class="flex items-center gap-2">
        <input type="hidden" name="page" value="1" />
        <div class="relative flex-1">
            <input type="search" name="q" value="@q"
                   class="block w-full rounded-lg border border-gray-300 bg-white py-2 pl-4 pr-10 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-[#FC651F] focus:outline-none focus:ring-1 focus:ring-[#FC651F]"
                   placeholder="Buscar por nombre o email..." />
        </div>
        <button type="submit"
                class="group flex items-center justify-center rounded-lg bg-gray-900 p-2.5 text-white shadow-sm transition-colors duration-200 hover:bg-[#FC651F] focus:outline-none"
                title="Buscar">
            <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
            </svg>
        </button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="Index" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-600 shadow-sm transition-colors hover:bg-gray-50 hover:text-gray-900">
                Limpiar
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="rounded-md bg-blue-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1 md:flex md:justify-between">
                <p class="text-sm text-blue-700">No hay usuarios registrados en el sistema.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="mt-8 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 bg-white text-sm text-left">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left font-semibold text-gray-900 sm:pl-6">Nombre</th>
                                <th scope="col" class="px-3 py-3.5 text-left font-semibold text-gray-900">Email</th>
                                <th scope="col" class="px-3 py-3.5 text-left font-semibold text-gray-900">Estado</th>
                                <th scope="col" class="px-3 py-3.5 text-left font-semibold text-gray-900">Roles</th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 whitespace-nowrap text-right font-semibold text-gray-900">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            @foreach (var usuario in Model)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 sm:pl-6">
                                        <div class="flex items-center">
                                            <div class="h-10 w-10 flex-shrink-0">
                                                <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold">
                                                    @usuario.Nombre.Substring(0, 1).ToUpper()
                                                </div>
                                            </div>
                                            <div class="ml-4">
                                                <div class="font-medium text-gray-900">@usuario.Nombre</div>
                                                <div class="text-gray-500 text-xs">ID: @usuario.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-gray-500">@usuario.Email</td>
                                    <td class="whitespace-nowrap px-3 py-4">
                                        @if (usuario.Activo)
                                        {
                                            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactivo</span>
                                        }
                                    </td>
                                    <td class="px-3 py-4 text-gray-500 max-w-xs truncate">
                                        @(usuario.Roles != null && usuario.Roles.Count > 0
                                            ? string.Join(", ", usuario.Roles.Select(r => r.Nombre))
                                            : "Sin rol")
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right sm:pr-6 font-medium">
                                        <div class="flex items-center justify-end gap-2">
                                            <a asp-action="Details" asp-route-id="@usuario.Id" class="text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-md transition-colors">Ver</a>
                                            <button type="button" onclick="openAjaxModal('@Url.Action("Edit", new { id = usuario.Id })')" class="text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-md transition-colors">Editar</button>
                                            <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn-delete-user text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-md transition-colors cursor-pointer block">Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 mt-2 rounded-b-lg">
            <div class="flex flex-1 justify-between sm:hidden">
                <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-activo="@activo" asp-route-rol="@rolFiltro" asp-route-permiso="@permisoFiltro" class="relative inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page <= 1 ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Anterior</a>
                <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-activo="@activo" asp-route-rol="@rolFiltro" asp-route-permiso="@permisoFiltro" class="relative ml-3 inline-flex items-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors @(page >= totalPages ? "pointer-events-none opacity-40 border-gray-200 text-gray-400" : "border-[#FC651F] text-[#FC651F] hover:bg-orange-50")">Siguiente</a>
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <p class="text-sm text-gray-700">Página <span class="font-medium">@(page)</span> de <span class="font-medium">@(totalPages)</span></p>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q" asp-route-activo="@activo" asp-route-rol="@rolFiltro" asp-route-permiso="@permisoFiltro" class="relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page <= 1 ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Anterior</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                    </a>
                    @for (var i = pgStart; i <= pgEnd; i++)
                    {
                        if (i == page)
                        {
                            <a href="#" aria-current="page" class="relative z-10 inline-flex items-center px-4 py-2 text-sm font-semibold text-white focus:z-20" style="background-color:#FC651F;">@i</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@i" asp-route-q="@q" asp-route-activo="@activo" asp-route-rol="@rolFiltro" asp-route-permiso="@permisoFiltro" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 hover:text-[#FC651F] focus:z-20">@i</a>
                        }
                    }
                    <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q" asp-route-activo="@activo" asp-route-rol="@rolFiltro" asp-route-permiso="@permisoFiltro" class="relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 transition-colors hover:bg-orange-50 focus:z-20 @(page >= totalPages ? "pointer-events-none opacity-40" : "text-[#FC651F]")">
                        <span class="sr-only">Siguiente</span>
                        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                    </a>
                </nav>
            </div>
        </div>
    }
}

<!-- AJX Modal Container -->
<div id="ajax-modal-container" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div id="ajax-modal-backdrop" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity opacity-0 z-50"></div>

    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div id="ajax-modal-content" class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl sm:p-6 opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
                
                <!-- Close Button -->
                <div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
                    <button type="button" onclick="closeAjaxModal()" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                        <span class="sr-only">Close</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Loading Spinner -->
                <div id="ajax-modal-loading" class="flex flex-col items-center justify-center py-10">
                    <svg class="animate-spin h-8 w-8 text-indigo-600 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-sm text-gray-500">Cargando...</span>
                </div>

                <!-- Injected Content -->
                <div id="ajax-modal-body" class="hidden"></div>
                
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.btn-delete-user').forEach(function(a) {
                a.addEventListener('click', function (e) {
                    const name = this.closest('tr')?.querySelector('.font-medium.text-gray-900')?.textContent?.trim() || 'este usuario';
                    if (!confirm(`¿Seguro que deseas eliminar ${name}? Esta acción no se puede deshacer.`)) {
                        e.preventDefault();
                    }
                });
            });

            // Click outside to close
            document.getElementById('ajax-modal-container').addEventListener('click', function(e) {
                if (e.target === document.querySelector('.fixed.inset-0.z-50.overflow-y-auto > div')) {
                    closeAjaxModal();
                }
            });
        });

        function hydrateAjaxContent(container) {
            if (!container) return;
            if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                const form = container.querySelector('form');
                if (form) {
                    window.jQuery.validator.unobtrusive.parse(form);
                }
            }
            executeInlineScripts(container);
            setupAjaxForm(container.querySelector('form'));
            if (window.initFieldTips) {
                window.initFieldTips(container);
            }
        }

        function executeInlineScripts(container) {
            if (!container) return;
            Array.from(container.querySelectorAll('script')).forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                oldScript.parentNode.replaceChild(newScript, oldScript);
            });
        }

        function openAjaxModal(url) {
            const container = document.getElementById('ajax-modal-container');
            const backdrop = document.getElementById('ajax-modal-backdrop');
            const content = document.getElementById('ajax-modal-content');
            const body = document.getElementById('ajax-modal-body');
            const loading = document.getElementById('ajax-modal-loading');

            // Reset state
            body.innerHTML = '';
            body.classList.add('hidden');
            loading.classList.remove('hidden');

            // Show modal
            container.classList.remove('hidden');
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                content.classList.remove('opacity-0', 'translate-y-4', 'sm:scale-95');
                content.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
            }, 10);

            // Fetch content
            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                loading.classList.add('hidden');
                body.innerHTML = html;
                body.classList.remove('hidden');
                hydrateAjaxContent(body);
            })
            .catch(err => {
                console.error('Error fetching modal content', err);
                body.innerHTML = '<div class="p-4 bg-red-50 text-red-700 rounded-md">Error cargando contenido.</div>';
                loading.classList.add('hidden');
                body.classList.remove('hidden');
            });
        }

        function closeAjaxModal() {
            const container = document.getElementById('ajax-modal-container');
            const backdrop = document.getElementById('ajax-modal-backdrop');
            const content = document.getElementById('ajax-modal-content');

            backdrop.classList.add('opacity-0');
            content.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
            content.classList.add('opacity-0', 'translate-y-4', 'sm:scale-95');
            
            setTimeout(() => {
                container.classList.add('hidden');
            }, 300);
        }

        function setupAjaxForm(form) {
            if (!form) return;
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Si el form es invalido del lado del cliente, no enviarlo
                if (window.jQuery && window.jQuery(form).valid && !window.jQuery(form).valid()) {
                    return;
                }

                const formData = new FormData(form);
                const url = form.getAttribute('action');
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn ? submitBtn.innerHTML : '';
                
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = 'Guardando...';
                }

                fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(async res => {
                    const contentType = res.headers.get("content-type");
                    if (contentType && contentType.indexOf("application/json") !== -1) {
                        const data = await res.json();
                        if (data.success) {
                            closeAjaxModal();
                            // Reload page or rows. Easiest is location.reload() to see success notification.
                            window.location.reload();
                        } else {
                            // Errores custom si se envian por JSON
                        }
                    } else {
                        // Devolvió una Vista Parcial porque hubo error de validación
                        const html = await res.text();
                        const body = document.getElementById('ajax-modal-body');
                        body.innerHTML = html;
                        hydrateAjaxContent(body);
                    }
                })
                .catch(err => {
                    console.error('Error submitting form', err);
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                });
            });
        }
    </script>
}
